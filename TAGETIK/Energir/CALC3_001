-- CALC3_001
-- Update Retained earning - Step - 3



WITH RankedData AS (
SELECT 
    FSCENARIO,
    FPERIOD,
    SENTITY,
    SACCOUNT,
    ACCOUNT,
    DEST1,
    DEST2,
    DEST3,
    DEST4,
    DEST5,
    SUM(AMOUNT) AS AMOUNT,
    SUM(ADJ_AMOUNT) AS ADJ_AMOUNT,
    LAG(SUM(AMOUNT), 4) OVER (PARTITION BY FSCENARIO, SENTITY, SACCOUNT,DEST1,DEST2,DEST3,DEST4,DEST5 ORDER BY FPERIOD) AS AMOUNT_LAG
FROM AW_FIN_000001_000002
WHERE SACCOUNT = '3100' 

GROUP BY 
    FSCENARIO, FPERIOD, SENTITY, ACCOUNT, DEST1, DEST2, DEST3, DEST4, DEST5,SACCOUNT
)

UPDATE Original
SET Original.YTD_AMOUNT = CASE
                                                        WHEN Original.FPERIOD IN ('01', '02', '03', '04') THEN  RD.AMOUNT + RD.ADJ_AMOUNT
                                                        ELSE RD.ADJ_AMOUNT + ISNULL(RD.AMOUNT_LAG, 0)
                                                END
FROM AW_FIN_000001_000002 AS Original
INNER JOIN RankedData AS RD
ON Original.FSCENARIO = RD.FSCENARIO
AND Original.FPERIOD = RD.FPERIOD
AND Original.SENTITY = RD.SENTITY
AND Original.ACCOUNT = RD.ACCOUNT
AND Original.DEST1=RD.DEST1
AND Original.DEST2=RD.DEST2
AND Original.DEST3=RD.DEST3
AND Original.DEST4=RD.DEST4
AND Original.DEST5=RD.DEST5
WHERE Original.ACCOUNT = '3100' AND  Original.FSCENARIO IN (SELECT DISTINCT(COD_SCENARIO) FROM SCENARIO_PERIODO
WHERE FLAG_BLOCCATO='0');
