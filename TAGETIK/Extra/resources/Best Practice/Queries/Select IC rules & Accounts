-- SELECT IC Rules & Accounts


SELECT 
A.COD_ELISIONE AS "RULE",
B.DESC_ELISIONE0 AS "RULE_DESC",
A.COD_CONTO AS "ACCOUNT",
C.DESC_CONTO0 AS "ACCOUNT_DESC",
A.FLAG_COMANDA AS "PRIMARY_ACCOUNT",
A.FLAG_CONTO_QUADRATURA AS "IC_MATCHING",
A.FLAG_CONTO_ELISIONE AS "ELIMINATION"



FROM REGOLA_ELISIONE_CONTO A, REGOLA_ELISIONE B, CONTO C
WHERE A.COD_ELISIONE = B.COD_ELISIONE
AND A.COD_CONTO = C.COD_CONTO

SELECT *  FROM REGOLA_ELISIONE_CONTO
