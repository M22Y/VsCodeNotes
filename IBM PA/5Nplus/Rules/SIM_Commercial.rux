      #                                                                          CONTINUE);

#BU/LRP From SIM_Commercial_Input & SIM_Selling_Price
#La nouvelle application des vendeurs sera effective a partir du BU-2019/LRP-2019-2&3
[] =N: IF (SUBST(!t_Scenario, 1, 7) @= 'BU-2018'%SUBST(!t_Scenario, 1, 10) @= 'LRP-2018-2'%SUBST(!t_Scenario, 1, 10) @= 'LRP-2018-3',STET,CONTINUE);

['Volume_Kg' ] = N: IF (!t_Scenario @=  DB('SYS_TimeRef', 'FORECAST', 'scenario')&NUMBR(!t_Months) =NUMBR( DB('SYS_TimeRef', 'forecast', 'Month')), STET, CONTINUE);

 #['Volume_Kg' ]=N: IF (SUBST(!t_Scenario, 1, 3) @= 'BU-'  % SUBST(!t_Scenario, 1, 4) @= 'LRP-'%(SUBST(!t_Scenario, 1,3) @= 'MRF'&NUMBR(!t_Months) >NUMBR( DB('SYS_TimeRef', 'forecast', 'Month'))),
['Volume_Kg' ]=N: IF (SUBST(!t_Scenario, 1, 3) @= 'BU-'  % SUBST(!t_Scenario, 1, 4) @= 'LRP-'%SUBST(!t_Scenario, 1,3) @= 'MRF',
                                                                                      DB('SIM_Commercial_Input',!Contract_Commercial,!Industries,!Entity,!Prod_Entity,!Sales_Rep,!Product,!Customers,!Countries,!t_Months,!t_Scenario,'Metal_Content_Kg'),
                                                                                       CONTINUE);

 ['Markup_Percent' ]=N:  IF  (SUBST(!t_Scenario, 1, 3) @= 'BU-'  % SUBST(!t_Scenario, 1, 4) @= 'LRP-'%SUBST(!t_Scenario, 1,3) @= 'MRF',
                                                                                     DB('SIM_Selling_Price',!Contract_Commercial,!Entity,!Prod_Entity,!Sales_Rep,!Product,!Customers,!t_Months,!t_Scenario,'Markup_%'),
                                                                                     CONTINUE);

 ['Markup_Fixe' ]=N: IF  (SUBST(!t_Scenario, 1, 3) @= 'BU-'  % SUBST(!t_Scenario, 1, 4) @= 'LRP-'%SUBST(!t_Scenario, 1,3) @= 'MRF',
                                                                                       DB('SIM_Selling_Price',!Contract_Commercial,!Entity,!Prod_Entity,!Sales_Rep,!Product,!Customers,!t_Months,!t_Scenario,'Markup_Fix_Calcul'),
                                                                                       CONTINUE);

 ['Markup_Index_Calcul' ]=N: IF (SUBST(!t_Scenario, 1, 3) @= 'BU-'  % SUBST(!t_Scenario, 1, 4) @= 'LRP-'%SUBST(!t_Scenario, 1,3) @= 'MRF',
                                                                                         DB('SIM_Selling_Price',!Contract_Commercial,!Entity,!Prod_Entity,!Sales_Rep,!Product,!Customers,!t_Months,!t_Scenario,'Markup_Index_Calcul'),
                                                                                         CONTINUE);
##############Added MG Test 03.17.2026
 ['Markup_Index_Ref' ]=S: IF (SUBST(!t_Scenario, 1, 3) @= 'BU-'  % SUBST(!t_Scenario, 1, 4) @= 'LRP-'%SUBST(!t_Scenario, 1,3) @= 'MRF',
                                                                                         DB('SIM_Selling_Price',!Contract_Commercial,!Entity,!Prod_Entity,!Sales_Rep,!Product,!Customers,!t_Months,!t_Scenario,'Markup_Index'),
                                                                                         CONTINUE);
#############Added MG Test 03.17.2026

##RG Added condition for Azure
 ['Markup_factor' ]=N: IF  (SUBST(!t_Scenario, 1, 3) @= 'BU-'  % SUBST(!t_Scenario, 1, 4) @= 'LRP-'%SUBST(!t_Scenario, 1,3) @= 'MRF',
                                                                                     IF(DB('}ElementAttributes_Entity',!Entity,'Company Type')  @= 'A',
							DB('SIM_Selling_Price',!Contract_Commercial,!Entity,!Prod_Entity,!Sales_Rep,!Product,!Customers,!t_Months,!t_Scenario,'Fix_Selling_Price_EUR'),
							DB('SIM_Selling_Price',!Contract_Commercial,!Entity,!Prod_Entity,!Sales_Rep,!Product,!Customers,!t_Months,!t_Scenario,'Markup_Factor_USD')),
 				                         CONTINUE);

 ['Fix_Selling_Price' ]=N:  IF(SUBST(!t_Scenario, 1, 3) @= 'BU-'  % SUBST(!t_Scenario, 1, 4) @= 'LRP-'%SUBST(!t_Scenario, 1,3) @= 'MRF',
                                                                                     DB('SIM_Selling_Price',!Contract_Commercial,!Entity,!Prod_Entity,!Sales_Rep,!Product,!Customers,!t_Months,!t_Scenario,'Fix_Selling_Price_Calcul'),
                                                                                     CONTINUE);





#endregion

############################# +++++++++++++++++  FEEDERS  +++++++++++++++++ #############################
FEEDERS;

['Amount_LC' ]=> ['Amount_USD' ];
['Volume_Kg' ] =>   ['Markup_Base'],
				['Markup_Factor'],
				['Sales_$kg' ],
				['Sales_LC/kg' ],
				['Volume'];
['Markup_Base'] => ['Markup_Factor'];



['Volume'] => ['Amount_LC'];

['Volume'] => ['Internal_Volume' ],['External_Volume' ];

### Sales incl Interco
['Amount_USD', 'All_Contracts','All_Customers'] =>
	 DB(IF ( SUBST(!t_Scenario, 1,2) @='BU','RPT_All',''), 'UP1000', !Product, '0_', 'All_Other', 'All_Department', !Entity, '@None', 'REPO', 'USD', !t_Months, !t_Scenario, 'Dollars');

['Amount_USD', 'All_Contracts','All_Customers'] =>
	 DB(IF ( SUBST(!t_Scenario, 1,3) @='LRP','RPT_All',''), 'UP1000', !Product, '0_', 'All_Other', 'All_Department', !Entity, '@None', 'REPO', 'USD', !t_Months, !t_Scenario, 'Dollars');

['Amount_USD', 'All_Contracts','All_Customers'] =>
	 DB(IF(NUMBR(!t_Months) <=DB('SYS_TimeRef', 'Actuals', 'MonthNb'),'Metal_Cost_Per_Entity',''), 'UP1000', !Product, !Entity, '@None', !t_Months, !t_Scenario, 'Sales_Amount_USD');

#Region MRF
### New Rules for MRF
[]=> DB (IF( SUBST(!t_Scenario,1,2)@='AC','SIM_Commercial',''), !Contract_Commercial,  !Industries,!Entity, !Prod_Entity,  !Sales_Rep, !Product, !Customers,!Countries, !t_Months,
			'MRF-'| SUBST(!t_Scenario,4,4), !m_Commercial);


## Feeder for volume in cube RPT_All
['Volume_Kg','All_Contracts' ,'All_Customers']  => DB('RPT_All', 'SSV100', !Product, '0_', 'All_Other', 'All_Department', !Entity, '@None', 'REPO', 'USD', !t_Months, !t_Scenario, 'Dollars');

#