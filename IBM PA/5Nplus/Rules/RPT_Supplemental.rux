####Replacement measures for committment and Lease Paymen#####

['USD', { 'P&L_Expenses1', 'P&L_Expenses2', 'P&L_Expenses3',
	'Commitments1', 'Commitments2', 'Commitments3', 'Commitments4', 'Commitments5', 'Commitments6', 'Commitments7', 'Commitments8',
	'Lease_Payments1', 'Lease_Payments2', 'Lease_Payments3', 'Lease_Payments4', 'Lease_Payments5', 'Lease_Payments6', 'Lease_Payments7', 'Lease_Payments8'}] =N:
	IF (ATTRS('Entity', !Entity, 'Local Currency') @= 'USD',
		CONTINUE,
		DB('RPT_Supplemental',  !Entity, !Sup_Accounts, !Activity_Type, !Categories, ATTRS('Entity', !Entity, 'Local Currency'), !t_Supplemental, !t_Scenario, !m_Supplemental)
		*DB('Exchange_Rate', DB('}ElementAttributes_Entity', !Entity, 'Local Currency') | '-USD', ATTRS('t_Supplemental',!t_Supplemental,'Months'), !t_Scenario, 'Period Spot'));

