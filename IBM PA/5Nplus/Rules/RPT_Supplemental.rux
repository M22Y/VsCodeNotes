#region  Sytem Commands
SKIPCHECK;
FEEDSTRINGS;

#endregion

###########
# Planning Model
###########
# Skip Calculations if scenario is frozen/backup & cube is considered into FCT/BUD model
[]=N: IF(ATTRS('t_Scenario',!t_Scenario,'isFrozen')@='YES' &  DB('SYS_Controls_Cube', 'RPT_Supplental','PlanningCube')@='YES' ,STET,CONTINUE);
[]=N: IF (ATTRS ('t_Scenario', !t_Scenario, 'isBackup') @= 'YES', STET, CONTINUE);


#USD for all entities except CIR/MHC/AZUR
['USD', 'Dollars',{ 'Sup8310_110', 'Sup8310_115', 'Sup8310_120', 'Sup8310_125', 'Sup8310_130', 'Sup8310_135', 'Sup8310_140', 'Sup8310_145', 'Sup8310_150', 'Sup8310_155', 'Sup8310_160', 'Sup8310_165','Sup8310_100','Sup4300_100','Sup4300_110','Sup4300_120','Sup4300_130'}] =N:
	IF (ATTRS('Entity', !Entity, 'Local Currency') @= 'USD',
		CONTINUE,
		DB('RPT_Supplemental',  !Entity, !Sup_Accounts, !Activity_Type, !Categories, ATTRS('Entity', !Entity, 'Local Currency'), !t_Supplemental, !t_Scenario, 'Dollars')
		*DB('Exchange_Rate', DB('}ElementAttributes_Entity', !Entity, 'Local Currency') | '-USD', ATTRS('t_Supplemental',!t_Supplemental,'Months'), !t_Scenario, 'YTD Average'));

['USD', 'Dollars'] =N:
	IF (ATTRS('Entity', !Entity, 'Local Currency') @= 'USD',
		CONTINUE,
		DB('RPT_Supplemental',  !Entity, !Sup_Accounts, !Activity_Type, !Categories, ATTRS('Entity', !Entity, 'Local Currency'), !t_Supplemental, !t_Scenario, 'Dollars')
		*DB('Exchange_Rate', DB('}ElementAttributes_Entity', !Entity, 'Local Currency') | '-USD', ATTRS('t_Supplemental',!t_Supplemental,'Months'), !t_Scenario, 'Period Spot'));
