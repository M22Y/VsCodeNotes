		*1);


['SUP3397_110']=-['SUP8700_130'];

['Allowance_Doubtful_Accounts', 'SUP1300_100']=C:['SUP1300_110']+['SUP1300_120']+['SUP1300_130']+['SUP1300_140'];

['Allowance_Doubtful_Accounts']=['Dollars']*['Rates'];

