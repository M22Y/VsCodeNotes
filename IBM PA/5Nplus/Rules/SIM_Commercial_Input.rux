#Region System
SKIPCHECK;
#EndRegion

#####################
# Planning Model
#####################
# Skip Calculations if scenario is frozen & cube is considered into FCT/BUD model
[]=N:IF(ATTRS('t_Scenario',!t_Scenario,'isFrozen')@='YES' &  DB('SYS_Controls_cube','SIM_Commercial_Input','PlanningCube')@='YES' ,STET,CONTINUE);
[]=N: IF (ATTRS ('t_Scenario', !t_Scenario, 'isBackup') @= 'YES', STET, CONTINUE);



#####################
# KPI Rules
#####################


#####  ONLY FORECAST/BU/LRP RULES CATCH ALL #####
# Only calculate on Current Scenario Forecast/BU/LRP

[] =
IF(
	SUBST(!t_Scenario,1,4)@= 'MRF-'
# 	%!t_Scenario@=DB('SYS_TimeRef', 'Budget', 'Scenario')
               %SUBST(!t_Scenario,1,3)@='BU-'
	%SUBST(!t_Scenario,1,4)@='LRP-'
	, CONTINUE
	, STET
);

#####################################
#Data FROM Current ACT Scenario to Current Focecast ACT Months
[{'Product_Kg', 'Metal_Content_KG', 'Amount_USD'}] = N:
	 IF( (NUMBR(!t_Months)<= NUMBR( DB('SYS_TimeRef','Forecast','Month') ) ) & !t_Scenario@= DB('SYS_TimeRef', 'Forecast', 'Scenario'),
	  DB('SIM_Commercial_Input', !Contract_Commercial,!Industries,!Entity,!Prod_Entity,!Sales_Rep,!Sub_Product,!Customers,!Countries,!t_Months,DB('SYS_TimeRef','Actuals','Scenario'),!m_Commercial_Input),
	  CONTINUE);


['Metal_Content_Kg']=N: IF(DB('MAP_Metal_Content','All_Metal',!Sub_Product,'Metal_Content_%')=0,DB('SIM_Commercial_Input',!Contract_Commercial,!Industries,!Entity,!Prod_Entity,!Sales_Rep,!Sub_Product,!Customers,!Countries,!t_Months,!t_Scenario,'Product_Kg') ,CONTINUE);

 ['Metal_Content_Kg'] = N:
	['Product_Kg'] * DB('MAP_Metal_Content','Sb',!Sub_Product,'Metal_Content_%')
+           ['Product_Kg'] * DB('MAP_Metal_Content','Bi',!Sub_Product,'Metal_Content_%')
+	['Product_Kg'] * DB('MAP_Metal_Content','Cd',!Sub_Product,'Metal_Content_%')
+	['Product_Kg'] * DB('MAP_Metal_Content','Ga',!Sub_Product,'Metal_Content_%')
+	['Product_Kg'] * DB('MAP_Metal_Content','Ge',!Sub_Product,'Metal_Content_%')
+	['Product_Kg'] * DB('MAP_Metal_Content','In',!Sub_Product,'Metal_Content_%')
+	['Product_Kg'] * DB('MAP_Metal_Content','Se',!Sub_Product,'Metal_Content_%')
+	['Product_Kg'] * DB('MAP_Metal_Content','Te',!Sub_Product,'Metal_Content_%')
+	['Product_Kg'] * DB('MAP_Metal_Content','Sn',!Sub_Product,'Metal_Content_%')
+	['Product_Kg'] * DB('MAP_Metal_Content','Zn',!Sub_Product,'Metal_Content_%')
+	['Product_Kg'] * DB('MAP_Metal_Content','Co',!Sub_Product,'Metal_Content_%')
+	['Product_Kg'] * DB('MAP_Metal_Content','Pb',!Sub_Product,'Metal_Content_%')
+	['Product_Kg'] * DB('MAP_Metal_Content','Ni',!Sub_Product,'Metal_Content_%')
+	['Product_Kg'] * DB('MAP_Metal_Content','Cl',!Sub_Product,'Metal_Content_%')
+	['Product_Kg'] * DB('MAP_Metal_Content','Ag',!Sub_Product,'Metal_Content_%')
+	['Product_Kg'] * DB('MAP_Metal_Content','Cu',!Sub_Product,'Metal_Content_%')
+	['Product_Kg'] * DB('MAP_Metal_Content','Fe',!Sub_Product,'Metal_Content_%')
+	['Product_Kg'] * DB('MAP_Metal_Content','Mo',!Sub_Product,'Metal_Content_%')
+	['Product_Kg'] * DB('MAP_Metal_Content','As',!Sub_Product,'Metal_Content_%');


##Added by RG###
['Amount_EUR'] = N: IF(DB('}ElementAttributes_Entity',!Entity,'Company Type')  @= 'A',
				['Metal_Content_Kg'] * DB('SIM_Selling_Price',!Contract_Commercial,!Entity,!Prod_Entity,!Sales_Rep,!Sub_Product,!Customers,!t_Months,!t_Scenario,'Fix_Selling_Price_EUR'), 0);

['Amount_USD'] = N: IF(DB('}ElementAttributes_Entity',!Entity,'Company Type')  @= 'A', ['Amount_EUR'] * DB('Exchange_Rate', 'EUR-USD', !t_Months, !t_Scenario, 'Period Average'), CONTINUE);
##End of code addition##

['Amount_USD'] = N:
	['Metal_Content_Kg'] * DB('SIM_Selling_Price',!Contract_Commercial,!Entity,!Prod_Entity,!Sales_Rep,!Sub_Product,!Customers,!t_Months,!t_Scenario,'Markup_Factor_USD');


# Bloquer la saisie du Product_KG si la valeur du Markup_Factor_USD =0
['Product_Kg']=N: IF(DB('SIM_Selling_Price',!Contract_Commercial,!Entity,!Prod_Entity,!Sales_Rep,!Sub_Product,!Customers,!t_Months,!t_Scenario,'Markup_Factor_USD')=0 & SUBST(!t_Scenario,1,2)@<>'AC' ,0, CONTINUE);

#####  ONLY FORECAST CATCH ALL #####
# Only calculate on Current Scenario Forecast/BU/LRP
#[] =
#IF(
#	!t_Scenario@= DB('SYS_TimeRef', 'Forecast', 'Scenario'),  CONTINUE
#	, STET
#);



FEEDERS;


#Data FROM Current ACT Scenario to Current Focecast ACT Months
[{'Product_Kg', 'Metal_Content_KG'}]  => DB('SIM_Commercial_Input', !Contract_Commercial,!Industries,!Entity,!Prod_Entity,!Sales_Rep,!Sub_Product,!Customers,!Countries,!t_Months,DB('SYS_TimeRef','Forecast','Scenario'),!m_Commercial_Input);
['Product_Kg'] => ['Metal_Content_Kg'];
['Metal_Content_Kg'] => ['Amount_USD'];
['Metal_Content_Kg'] => ['Amount_EUR'];
['Metal_Content_Kg']  => DB('SIM_Commercial',!Contract_Commercial,!Industries,!Entity,!Prod_Entity,!Sales_Rep,ATTRS('Sub_Product',!Sub_Product, 'Main_Product'),!Customers,!Countries,!t_Months,!t_Scenario,'Volume_Kg');
['Metal_Content_Kg']  => DB('SIM_Commercial',!Contract_Commercial,!Industries,!Entity,!Prod_Entity,!Sales_Rep,!Sub_Product,!Customers,!Countries,!t_Months,!t_Scenario,'Volume_Kg');




