['Markup_Index_Calcul']=>DB('SIM_Commercial',!Contract_Commercial,'All_Industries',!Entity,!Prod_Entity,!Sales_Rep,!Sub_Product,!Customers,ATTRS('Customers',!Customers, 'Country'),!t_Months,!t_Scenario,'Markup_Index_Calcul');

