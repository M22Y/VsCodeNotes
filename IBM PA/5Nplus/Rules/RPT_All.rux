#############################
['0_',  'All_Other', 'D998',Counter_Cie:'@None', 'REPO', 'Dollars'] =N:
                                                IF ( ELISANC('Account', 'Fixed & Variable (other than metal)', !Account)=1 & !t_Scenario @<>'BU-2017',
