#Region Production units from Productoin_Cost cube

['SPV100 - Production Units'] = N: IF (!t_Scenario @='AC-2023', STET, DB('Production_Cost',!Entity,!Product,!Account,!Currency,!t_Months,!t_Scenario,'Dollars'));

