##RG Added for Azure
##Exception Added for accounts and for EUR;
##Exception UP2218 removed as per MC request
['EUR', {'UP2300','UP2301','UP2375','UP2501','UP2500','UP2515','UP2401','UP2402','UP2218'}] = STET;

['EUR']=N: IF(DB('}ElementAttributes_Entity',!Entity,'Company Type')  @= 'A',
				['USD'] *
		                           		IF( ATTRS('Entity',!Entity, 'Local Currency')@<>'USD',
						DB('Exchange_Rate','USD-' | DB('}ElementAttributes_Entity', !Entity, 'Local Currency'), !t_months, !t_Scenario, 'Period Average'),
						1), CONTINUE);

##Convert EUR to USD only for the exception accounts
['USD', {'UP2300','UP2301','UP2375','UP2501','UP2500','UP2515','UP2401','UP2402','UP2218'}] =N:  IF(DB('}ElementAttributes_Entity',!Entity,'Company Type')  @= 'A',
                                                                                    				['EUR'] * DB('Exchange_Rate','EUR-USD', !t_months, !t_Scenario, 'Period Average')
                                                                                                    , CONTINUE);

#Region FBI
#####  ONLY FORECAST RULES CATCH ALL #####
# Only calculate on Current Scenario Forecast
[] = N:IF(!t_Scenario @= DB('SYS_TimeRef','Forecasting','Scenario'),
	 CONTINUE, STET);
#####################################

#Data FROM Current ACT Scenario to Current Focecast ACT Months
['Dollars'] = N:
	 IF( (NUMBR(!t_Months)<= NUMBR( DB('SYS_TimeRef','Forecasting','Month') ) ),
                DB('RPT_ALL',!Account, !Product, !Journal_Nb, !Activity_Type, !Department, !Entity,!Counter_Cie,!Closing_Version, !Currency, !t_Months,DB('SYS_TimeRef','Actuals','Scenario'),'Dollars'),
	 CONTINUE);

#EndRegion


############################# +++++++++++++++++FEEDERS  +++++++++++++++++ #############################
FEEDERS;

#region HC
['ST9000', 'C-All_Other', 'C-Dept', 'C-All_Product' , 'Dollars'] => ['salaries_per_employees' , 'C-All_Other'],
									['TCE_yees', 'C-All_Other' ],
									['salaries_BU_per_employee', 'C-All_Other'];

['ST9000', t_Months:{'01','02','03','04','05','06','07','08','09','10','11','12'}]  =>
	DB('RPT_All', !Account, !Product, !Journal_Nb, !Activity_Type, !Department, !Entity, !Counter_Cie, !Closing_Version, !Currency, 'YTD_' | !t_Months, !t_Scenario, !m_EBITDA);
#endregion

#region Sales
['UP1000', 'C-All_Other', 'C-DEPT', Currency:'USD', 'Dollars'] => ['SYS_UP1000', 'All_Other',  'All_Department'];


['UP1500', 'C-All_Other', 'C-DEPT', Currency:'USD', 'Dollars'] => ['SYS_UP1500', 'All_Other',  'All_Department'];

['UP1500', 'C-All_Other', 'C-DEPT', Counter_Cie:'AllCounterComp', Currency:'USD', 'Dollars'] => ['SYS_UP1500', 'All_Other',  'All_Department', Counter_Cie:'@None'];

['UP1000', 'All_Other', 'All_Department', 'REPO', Currency:{'USD','EUR'}, 'Dollars'] => ['SSV100'], ['SYS_UP1000'];
#['UP1000', 'All_Other', 'All_Department', Counter_Cie:'@None', 'REPO', Currency:'USD', 'Dollars'] => ['SSV100'], ['SYS_UP1000'];

['SYS_UP1000'] =>
	['Sales_Qty_in_KG'],
	['Sales_Entity_Kg'];
['SYS_UP1500'] =>
                ['Sales_Qty_in_KG'],
	['Sales_Entity_Kg'],
	['Interco_sales_by_kg'];
['Total revenue' ]  => ['MetalMargin%' ],
				   ['Gross_Margin%' ],
				   ['adj_EBITA_%' ],
				   ['EBITDA_%' ];

['Earnings Before Income Taxes' ]  => ['Tax_Rate' ];

#endregion

#region $/kg value

['PUR100', 'C-All_Other', 'C-All_Department', 'AllJournals', 'AllCounterComp', 'REPO', 'C-All_Product', 'Dollars'] => ['Purchase_by_$kg' ];

['SSV100', 'C-All_Other', 'C-All_Department', '0_', Counter_Cie:'@None', 'REPO', 'Dollars'] =>
	['Sales_Qty_in_KG'],
	['Sales_Entity_Kg'],
	['Interco_sales_by_kg'],
	['EBITDA_costs_WO_FreightOut_kg'],
	['Prod_costs_WO_FreightOut_Kg'],
	['Prod_costs_Kg'],
	['EBITDA_costs_kg' ];

['Sales_Qty_in_KG', 'All_Other', 'All_Department', '0_', Counter_Cie:'@None', 'REPO', 'Dollars'] =>
			[ 'MetalMargin_$kg'],
			[ 'MetalCosts_in_$kg'];


['SSV150', 'C-All_Other', 'C-All_Department', '101_', 'All Counter Comp', 'J1', 'Dollars'] => ['Sales_Qty_in_Kg'];


# Feeders MetalMargin

 [ 'Variable costs metal'] => [ 'MetalCosts_in_$kg'];
 [ 'Inventory fluctuation value'] => [ 'MetalCosts_in_$kg'];
 ['Variable costs metal - group'] => [ 'MetalCosts_in_$kg'];
 ['Impairment (Reversal)' ] => [ 'MetalCosts_in_$kg'];

 ['Sales_Qty_in_KG'] => [ 'MetalMargin_$kg'];
 ['MetalCosts_in_$kg'] => [ 'MetalMargin_$kg'];



#endregion

#Region Opening_Balance
['Dollars', 'Dec']=> DB (IF( SUBST(!t_Scenario,1,2)@='AC','RPT_All',''), !Account, !Product, !Journal_Nb, !Activity_Type, !Department, !Entity, !Counter_Cie, !Closing_Version, !Currency, 'Opening_Balance', 'AC-'| STR(NUMBR(SUBST(!t_Scenario,4,4))+1,4,0),
!m_EBITDA);

#EndRegion

#Region MRF
###vlo  New Rules for MRF
['Dollars']=> DB (IF( SUBST(!t_Scenario,1,2)@='AC','RPT_All',''), !Account, !Product, !Journal_Nb, !Activity_Type, !Department, !Entity, !Counter_Cie, !Closing_Version, !Currency, !t_Months, 'MRF-'| SUBST(!t_Scenario,4,4),
!m_EBITDA);


#EndRegion


['UP1500' ] => ['SYS_UP1500' ];
['UP1000' ]  => ['UP1500' ] ;
['ssv150' ]  => ['ssv151' ] ;
#Actual azur entity to be defined in below feeder
['USD', Counter_Cie:'AZUR', Entity:'AZUR',  {'UP1000','UP2218'} ] => ['EUR'];
['USD', Counter_Cie:'EARTH', Entity:'EARTH',{'UP1000','UP2218'} ] => ['EUR'];
['USD', Counter_Cie:'@NONE', Entity:'AZUR', {'UP1000','UP2218'} ] => ['EUR'];
['USD', Counter_Cie:'@NONE', Entity:'EARTH',{'UP1000','UP2218'} ] => ['EUR'];
['EUR', Counter_Cie:{'AZUR', '@None'}, Entity:'AZUR', {'UP2300','UP2301','UP2375','UP2501','UP2500','UP2515','UP2401','UP2402','UP2218'} ] => ['USD'];
['EUR', Counter_Cie:{'EARTH', '@None'}, Entity:'EARTH', {'UP2300','UP2301','UP2375','UP2501','UP2500','UP2515','UP2401','UP2402','UP2218'} ] => ['USD'];

