['SB2100_10','C-All_Product','AllJournals','C-All_Department - Total','All Counter Comp','CL ALL','Dollars'] => DB('SIM_Capex',!Entity,'SB2100_10','RPT_All_Project','RPT_Category_Capex',!Activity_Type,!Currency,!t_Months,!t_Scenario,'Dollars');
['SB2000_10','C-All_Product','AllJournals','C-All_Department - Total','All Counter Comp','CL ALL','Dollars'] => DB('SIM_Capex',!Entity,'CAP2000_10','RPT_All_Project','RPT_Category_Capex',!Activity_Type,!Currency,!t_Months,!t_Scenario,'Dollars');
['SB2100_10','C-All_Product','AllJournals','C-All_Department - Total','All Counter Comp','CL ALL','Dollars'] => DB('SIM_Capex',!Entity,'CAP2100_10','RPT_All_Project','RPT_Category_Capex',!Activity_Type,!Currency,!t_Months,!t_Scenario,'Dollars');

