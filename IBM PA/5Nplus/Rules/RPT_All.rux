#region EBITDA costs in kg
['SSV151' ] = N: ['SSV150' ];

['Prod_costs_Kg', 'Conso.C999' , 'C-All_Department - Total', 'C-All_Other' , 'All Counter Comp' ] = C :
					(['Variable costs other than metal'] + ['Total fixed costs']) * 1000
					\round(['ssv100'] + ['ssv151']);


['Prod_costs_Kg'] =  (['Variable costs other than metal'] + ['Total fixed costs'])* 1000\
                                                                              round(['ssv100'] + ['ssv151']);

['Prod_costs_WO_FreightOut_Kg', 'Conso.C999' , 'C-All_Department - Total', 'C-All_Other' , 'All Counter Comp' ] = C :
					(['Variable costs other than metal'] - ['Freight Out'] + ['Total fixed costs']) * 1000
					\round(['ssv100'] + ['ssv151']);


['Prod_costs_WO_FreightOut_Kg'] =  (['Variable costs other than metal'] - ['Freight Out'] + ['Total fixed costs'])* 1000\
                                                                              round(['ssv100'] + ['ssv151']);

['EBITDA_costs_WO_FreightOut_kg', 'Conso.C999' , 'C-All_Department - Total', 'C-All_Other' , 'All Counter Comp' ] = C :
					(['Variable costs other than metal'] - ['Freight Out'] + ['Total fixed costs'] + ['Selling General and Administrative Expenses'] + ['Total other expenses'] + ['UP6119']) * 1000
					\round(['ssv100'] + ['ssv151']);


['EBITDA_costs_WO_FreightOut_kg'] =  (['Variable costs other than metal'] - ['Freight Out'] + ['Total fixed costs'] + ['Selling General and Administrative Expenses'] + ['Total other expenses'] + ['UP6119'] )* 1000\
                                                                              round(['ssv100'] + ['ssv151']);


['EBITDA_costs_kg', 'Conso.C999' , 'C-All_Department - Total', 'C-All_Other' , 'All Counter Comp' ] = C :
					(['Variable costs other than metal'] + ['Total fixed costs'] + ['Selling General and Administrative Expenses'] + ['Total other expenses'] + ['UP6119']) * 1000
					\round(['ssv100'] + ['ssv151']);


['EBITDA_costs_kg'] =  (['Variable costs other than metal'] + ['Total fixed costs'] + ['Selling General and Administrative Expenses'] + ['Total other expenses'] + ['UP6119'] )* 1000\
                                                                              round(['ssv100'] + ['ssv151']);


['FC_$Kg', 'Conso.C999' , 'C-All_Department - Total', 'C-All_Other' , 'All Counter Comp' ] = N :
					(['Total fixed costs']) * 1000
					\round(['ssv100']);


['FC_$Kg'] =  (['Total fixed costs'])* 1000\
                                                                              round(['ssv100'] + ['ssv151']);


['VC_$Kg', 'Conso.C999' , 'C-All_Department - Total', 'C-All_Other' , 'All Counter Comp' ] = N :
					(['Variable costs other than metal']) * 1000
					\round(['ssv100']);


['VC_$Kg'] =  (['Variable costs other than metal'] )* 1000\
                                                                              round(['ssv100'] + ['ssv151']);

['Gross_Margin_$kg', 'Conso.C999' , 'C-All_Department - Total', 'C-All_Other' , 'All Counter Comp' ] = N :
					(['Gross margin']) * 1000
					\round(['ssv100']);

['Gross_Margin_$kg'] =  (['Gross margin' ])* 1000\
                                                                              round(['ssv100'] + ['ssv150']);

# Original GM/kg formula. Modified 02.19.2024 MG
#['Gross_Margin_$kg'] =  (['Gross margin' ])* 1000\
#                                                                            round(['ssv100'] + ['ssv151']);




#endregion


['Conso.C999', {'SYS_UP1500','SSV150'} ]  = C: 0 ;


###vlo new rules for MRF (Not for MRF3 and more)
[] =N: IF (SUBST(!t_Scenario, 1, 4) @= 'MRF-',
			IF (!t_Months @= 'Opening_Balance' & SUBST(!Account, 2,1) @= 'B',
				DB('RPT_All', !Account, !Product, !Journal_Nb, !Activity_Type, !Department, !Entity, !Counter_Cie, !Closing_Version, !Currency,
					'YTD_Dec', 'AC-' | STR(NUMBR(SUBST(!t_Scenario, 5, 4))-1,4,0) , !m_EBITDA),
				CONTINUE),
			CONTINUE);

[] =N: IF (SUBST(!t_Scenario, 1, 4) @= 'MRF-',
			IF (!t_Months @<= DB('SYS_TimeRef', 'Actuals', 'Month'),
				DB('RPT_All', !Account, !Product, !Journal_Nb, !Activity_Type, !Department, !Entity, !Counter_Cie, !Closing_Version, !Currency, !t_Months,
					'AC-' | SUBST(!t_Scenario, 5, 4) , !m_EBITDA),
				CONTINUE),
			CONTINUE);

#region Calculate $/kg on purchases

['Purchase_by_$kg' ] = ['PT1000' ] \['PUR100' ]*1000 ;

#endregion


#region Calculate $/kg on Inventory

['Value in $/kg' ]  = ['ST1599' ] \['QT1599' ]*1000 ;

#endregion

#region Calculate Operating earnings (Loss)
['Operating earnings (Loss)'] = ['UP1099'] - ['Cost of Sales'] - ['Selling General and Administrative Expenses'] - ['Other Expense'];
#endregion


#region Calcul particulié pour le conso sur les comptes interco

['Conso.C999' , 'Sales_by_Quantity' ] = ['SSV100' ];

#endregion

#region Metal Margin and Gross Margin %

['MetalMargin%' ] =  ['Métal Margin'] \ round(['Total revenue']);

['Gross_Margin%' ] =  ['Gross margin' ] \ round(['Total revenue' ]);

['adj_EBITA_%' ] = ['adj_EBITDA' ] \ round(['Total revenue' ]);

['EBITDA_%' ] = ['EBITDA' ] \ round(['Total revenue' ]);

#endregion

#region Calcul du Tax Rate

['Tax_Rate' ] = ['Total Income Tax Expense' ] \ ['Earnings Before Income Taxes' ] ;

#endregion

#region Calculate sales by kg

['Sales_Entity_Kg' ] =
 (['SYS_UP1500'] +['SYS_UP1000'])
  \(['SSV100', 'All_Department', 'All_Other', 'AllCounterComp'] +['SSV150', 'All_Department', 'All_Other', 'AllCounterComp']) *1000;

['Interco_sales_by_kg'] = ['SYS_UP1500'] \['SSV150', 'All_Department', 'All_Other', 'AllCounterComp'] * 1000 ;

['Sales_Qty_in_KG'] = (['SYS_UP1000'] + ['SYS_UP1500']) \(['SSV100', 'All_Department', 'All_Other', 'AllCounterComp'] + ['SSV150', 'All_Department', 'All_Other', 'AllCounterComp']) *1000;
#['Sales_Qty_in_KG'] = (['SYS_UP1000']) \(['SSV100', 'All_Department', 'All_Other', 'AllCounterComp']) *1000;

[ 'MetalCosts_in_$kg'] = ([ 'Variable costs metal'] + [ 'Inventory fluctuation value'] + ['Variable costs metal - group'] + ['Impairment (Reversal)' ] ) \ (['SSV100', 'All_Department', 'All_Other', 'AllCounterComp']
+ ['SSV150', 'All_Department', 'All_Other', 'AllCounterComp']) *1000;


#[ 'MetalMargin_$kg'] = ['Sales_Qty_in_KG'] -  ['MetalCosts_in_$kg'];
#[ 'MetalMargin_$kg'] =( ['Métal Margin'] \['SSV100', 'All_Department', 'All_Other', 'AllCounterComp'])*1000 ;
[ 'MetalMargin_$kg'] = IF ( SUBST(!t_Scenario, 1, 3) @= 'AC-' , ['Sales_Qty_in_KG'] -  ['MetalCosts_in_$kg'],( ['Métal Margin'] \['SSV100', 'All_Department', 'All_Other', 'AllCounterComp'])*1000) ;

#endregion


#Region Data <<from Other Cubes>>   HC, Sales, OPEX (Act, Bud), Recycling

#HC
#Budget HC are loaded in OPEX cube
['ST9000', Currency:'USD'] = DB('Other_Expenses', !Account, !Entity, !Department, !Counter_Cie, !Closing_Version, !Currency, !t_Months, !t_Scenario, !m_EBITDA);
['ST9000'] =N: STET;
#endregion

#fk6 Utiliser 'TCE' plutot que la somme manuelle des UP----
#region Sales per employees and salaries by employees
['sales_per_employees' , 'Dollars' ] = (['SSV100' ]+ ['SSV150' ] )\['ST9000'] ;
['salaries_per_employees', 'Dollars'  ] = ((['UP2003']+['UP2006']+['UP2007'] +['UP3003']+['UP3004']+['UP3100']+['UP3120']+['UP3150']+['UP3200']+ ['UP6106'] + ['UP6107']+ + ['UP2237'])*12 ) \['ST9000'];
#endregion


#region Total Costs of employment
['TCE_yees', 'Dollars' ] = ((['TCE'])) \['ST9000'];
#['TCE_yees', 'Dollars' ] = ((['UP2003']+['UP2006']+['UP2007'] +['UP3003']+['UP3004']+['UP3100']+['UP3120']+['UP3150']+['UP3200']+ ['UP6106'] + ['UP6107']+ ['UP2237'])) \['ST9000'];
#endregion

#Region SYS_UP1000 & SYS_UP1500
[{'SYS_UP1000'}, 'All_Other',  'All_Department', Currency:'USD', 'Dollars'] =N:
	IF (ATTRS ('t_Scenario', !t_scenario, 'isActual') @= 'Y',
		DB('FAP_Staging', SUBST(!Account, 5, 6), !Product, !Journal_Nb, 'C-All_Other', 'C-DEPT', !Entity, !Counter_Cie, 'AllOrigComp', !Closing_Version, 'CT FL', 'CO ALL', 'C-All_Segment',
			'C-D999', !Currency, '@None', ATTRS ('t_Scenario', !t_scenario, 'Version'), ATTRS ('t_Scenario', !t_scenario, 'Year') |!t_Months, 'Monthly'),
		['UP1000']);

[{'SYS_UP1500'}, 'All_Other', 'All_Department', Counter_Cie:'@None', Currency:'USD', 'Dollars'] =N:
	IF (ATTRS ('t_Scenario', !t_scenario, 'isActual') @= 'Y',
		DB('FAP_Staging', SUBST(!Account, 5, 6), !Product, !Journal_Nb, 'C-All_Other', 'C-DEPT', !Entity, 'AllCounterComp', 'AllOrigComp', !Closing_Version, 'CT FL', 'CO ALL', 'C-All_Segment',
			'C-D999', !Currency, '@None', ATTRS ('t_Scenario', !t_scenario, 'Version'), ATTRS ('t_Scenario', !t_scenario, 'Year') |!t_Months, 'Monthly'),
		CONTINUE);

[{'SYS_UP1500'}, 'All_Other', 'All_Department', Currency:'USD', 'Dollars'] =N: IF ( SUBST(!t_Scenario, 1, 3) @= 'BU-' ,
			DB('RPT_All', 'UP1500', !Product, !Journal_Nb, !Activity_Type, !Department, !Entity, !Counter_Cie, !Closing_Version, !Currency, !t_Months, !t_Scenario, !m_EBITDA),
			CONTINUE);

[{'SYS_UP1500'}, 'All_Other', 'All_Department', Currency:'USD', 'Dollars'] =N: IF ( SUBST(!t_Scenario, 1, 3) @= 'LRP' ,
			DB('RPT_All', 'UP1500', !Product, !Journal_Nb, !Activity_Type, !Department, !Entity, !Counter_Cie, !Closing_Version, !Currency, !t_Months, !t_Scenario, !m_EBITDA),
			CONTINUE);

#[{'SYS_UP1500'}, 'All_Other', 'All_Department',  '0_', Currency:'USD', 'Dollars'] =N:
#	 IF (SUBST(!t_Scenario, 1, 4) @= 'MRF-',
#		IF (!t_Months @<= DB('SYS_TimeRef', 'Actuals', 'Month'),
#			DB('RPT_All', 'UP1500', !Product, !Journal_Nb, !Activity_Type, !Department, !Entity, !Counter_Cie, !Closing_Version, !Currency, !t_Months, !t_Scenario, !m_EBITDA),
#			CONTINUE),
#		CONTINUE);

#endregion

#Region Opening_Balance
#To calculate the opening balance of the Rpt_ALL
['Opening_Balance', 'Dollars'] =N:
 	IF ( ATTRS ('t_Scenario', !t_scenario, 'isActual') @= 'Y',
         IF(ATTRS ('Account' , !Account, 'Account Type') @= 'A'
         % (ATTRS ('Account' , !Account, 'Account Type') @= 'L')
         % (ATTRS ('Account' , !Account, 'Account Type') @= 'E')
	    % (ATTRS ('Account' , !Account, 'Account Type') @= 'R')
	    % (ATTRS ('Account' , !Account, 'Account Type') @= 'F'),
			DB('FAP_Staging', !Account, !Product, !Journal_Nb, !Activity_Type, !Department, !Entity, !Counter_Cie, 'AllOrigComp', !Closing_Version,
			 'CT FL', 'CO ALL', 'C-All_Segment', 'C-All_Segment', !Currency,
		     '@None', ATTRS('t_Scenario', !t_scenario ,'Version'), ATTRS('t_Scenario', !t_scenario , 'PrevYear') | '12', 'YTD'),
		STET),
		STET);

#EndRegion

#Region Other Expenses Exceptions (avoid duplicate on PROD & All_Other Activity_type
###Fk6 Labor accounts all reads from OPEX
['PROD', 'OP10', 'Dollars'] =N:
	  IF (ATTRS ('t_Scenario', !t_scenario, 'isActual') @= 'Y',
		IF ( ATTRS('Account', !Account, 'Salaries_Department_Level') @<> '', 0, CONTINUE),
		 CONTINUE);

['D998', 'OP10', 'Dollars']=N:
	IF (ATTRS ('t_Scenario', !t_scenario, 'isActual') @= 'Y',
		IF ( ELISANC('Account', 'TEC', !Account) = 1 & ATTRS('Account', !Account, 'Salaries_Department_Level') @= '', 0, CONTINUE),
		 CONTINUE);



#EndRegion


###Fk6 Rule générale qui porte sur le périmètre Actual
#Region GENERAL Rules :: Actuals, Budget & LBE
['Dollars'] =N: IF (ATTRS ('t_Scenario', !t_scenario, 'isActual') @= 'Y',
		DB('FAP_Staging', !Account, !Product, !Journal_Nb, !Activity_Type, !Department, !Entity, !Counter_Cie, 'AllOrigComp', !Closing_Version, 'CT FL', 'CO ALL', 'C-All_Segment',
		    'C-D999', !Currency, '@None', ATTRS ('t_Scenario', !t_scenario, 'Version'), ATTRS ('t_Scenario', !t_scenario, 'Year') |!t_Months, 'Monthly'),
		CONTINUE);
######La seule regle Linké au RPT_Commercial au lieu de SIM_Commercial (La raison: Pour controller l'input des vendeurs vers le modele TM1)
['SSV100', '0_', 'All_Other', 'All_Department', Counter_Cie:'@None', 'REPO', Currency:{'USD', 'EUR'}, 'Dollars'] =N:
#		DB('Sales', 'All_Contracts', !Product, 'All_Customers', !Entity, !t_Months, !t_Scenario, 'Volume_KG');
                                DB ('RPT_Commercial', 'All_Contracts','All_Industries',!Entity, 'All_Prod_Entity', 'All_Sales_rep',!Product, 'All_Customers','World', !t_Months,!t_Scenario, 'Volume_KG');

#endregion



#Region Interco Purchases & Sales  <::>  Interco Group (SUPP_0172) Interco Cusotmer (CUST_4899)
# l'information Metal cost pour BU-2015 est encore depuis le cube Recycling (qui inclu des Suppliers) en attendant de passer au mode Inventory Spending et ses TIs
['BU-2015',
'UP1500', '0_', 'All_Other', 'All_Department', 'REPO', Currency:'USD', 'Dollars'] =N:
       #   DB('Sales', 'All_Contracts', !Product, 'CUST_4899',!Entity, !t_Months, !t_Scenario, 'Amount_USD')\1000;
           DB ('SIM_Commercial', 'All_Contracts','All_Industries',!Entity, 'All_Prod_Entity', 'All_Sales_rep', 'Cust_4899', 'World',!t_Months,!t_Scenario, 'Amount_USD')\1000;

#['BU-2015',
#'UP2500', '0_', 'All_Other', 'All_Department', 'REPO', Currency:'USD', 'Dollars'] =N:
 #        DB('Recycling', 'All_Contracts', !Product, 'SUPP_0172',!Entity, !t_Months, !t_Scenario, 'Amount_USD')\1000;


#Ventes Externes- RPT_Recycling
['UP1000', '101_', 'All_Other', 'All_Department', 'REPO', Currency:'USD', 'Dollars'] =N:
                        DB('RPT_Recycling', 'All_Contracts', !Product, 'All_Supplier',!Entity,!Counter_Cie, !t_Months, !t_Scenario, 'UP1000')\1000;

#Les ventes interco- RPT_Recycling

['UP1500', '101_', 'All_Other', 'All_Department', 'REPO', Currency:'USD', 'Dollars'] =N:IF(!Entity@<>'999ADJ',
                        DB('RPT_Recycling', 'All_Contracts', !Product, 'All_Supplier',!Entity,!Counter_Cie, !t_Months, !t_Scenario, 'UP1500')\1000,STET);




#Ventes Externes- Metel Cost Cube
['UP1000', '0_', 'All_Other', 'All_Department', 'REPO', Currency:'USD', 'Dollars'] =N:
		DB('Metal_Cost_Per_Entity', !Account, !Product, !Entity, !Counter_Cie, !t_Months, !t_Scenario, 'Sales_Amount_USD')\1000;

#Ventes Internes- Metel Cost Cube

['UP1500', '0_', 'All_Other', 'All_Department', 'REPO', Currency:'USD', 'Dollars'] =N: IF(!Entity@<>'999ADJ',
		DB('Metal_Cost_Per_Entity', !Account, !Product, !Entity, !Counter_Cie, !t_Months, !t_Scenario, 'Sales_Amount_USD')\1000,
		STET);
#Kg des Ventes Intercos
['SSV150','Counter_Cie':'@none','REPO' ] =N:DB('Metal_Cost_Per_Entity', 'UP1500', !Product, !Entity, 'AllCounterComp', !t_Months, !t_Scenario, 'Volume_Sales');

#Metal cost Externe-RPT_Recycling
['UP2300', '101_', 'All_Other', 'All_Department', 'REPO', Currency:'USD', 'Dollars'] =N:
		DB('RPT_Recycling', 'All_Contracts', !Product, 'All_Supplier',!Entity,!Counter_Cie, !t_Months, !t_Scenario, 'Amount_USD')\1000;
#Metal Cost Interne-RPT_Recycling
['UP2500', '101_', 'All_Other', 'All_Department', 'REPO', Currency:'USD', 'Dollars'] =N:IF(!Entity@<>'999ADJ',
		DB('RPT_Recycling', 'All_Contracts', !Product, 'All_Supplier',!Entity,!Counter_Cie, !t_Months, !t_Scenario, 'Amount_USD_Group')\1000,STET);

#Metal cost Externe- Metal Cost Cube
['UP2300', '0_', 'All_Other', 'All_Department', 'REPO', Currency:'USD', 'Dollars'] =N:
		DB('Metal_Cost_Per_Entity', !Account, !Product, !Entity, !Counter_Cie, !t_Months, !t_Scenario, 'Metal_Cost_Total_USD')\1000;
#Metal cost Interne- Metal Cost Cube
['UP2500', '0_', 'All_Other', 'All_Department', 'REPO', Currency:'USD', 'Dollars'] =N:IF(!Entity@<>'999ADJ',
		DB('Metal_Cost_Per_Entity', !Account, !Product, !Entity, !Counter_Cie, !t_Months, !t_Scenario, 'Metal_Cost_Total_USD')\1000,
		STET);

#endregion



#####  BUDGET AND FORECAST RULES CATCH ALL #####
# Only calculate on Scenario Budget / Forecast
[] = N: IF(SUBST(!t_Scenario,1,3)@='MRF' % SUBST(!t_Scenario,1,2)@='BU'% SUBST(!t_Scenario,1,3)@='LRP',
CONTINUE, STET);
