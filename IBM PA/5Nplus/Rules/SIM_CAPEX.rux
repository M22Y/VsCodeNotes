###########
# Business Rules
###########
##Copy actuals

['SB2000_10','RPT_All_Project','Dollars', 'RPT_Category_Capex'] = N: IF(!Currency @= DB('}ElementAttributes_Entity',!Entity,'Local Currency')
						,DB('RPT_All','SB2000_10','C-All_Product','AllJournals',!Activity_Type,'C-All_Department - Total',!Entity,'All Counter Comp','CL ALL',!Currency,!t_Months,!t_Scenario,'Dollars')
						,CONTINUE);

['CAP2000_10','RPT_All_Project','Dollars', 'RPT_Category_Capex'] = N: IF(!Currency @= DB('}ElementAttributes_Entity',!Entity,'Local Currency')
						,DB('RPT_All','SB2000_10','C-All_Product','AllJournals',!Activity_Type,'C-All_Department - Total',!Entity,'All Counter Comp','CL ALL',!Currency,!t_Months,!t_Scenario,'Dollars')
						,CONTINUE);

['SB2100_10','RPT_All_Project','Dollars', 'RPT_Category_Capex'] = N: IF(!Currency @= DB('}ElementAttributes_Entity',!Entity,'Local Currency')
						,DB('RPT_All','SB2100_10','C-All_Product','AllJournals','c-i999','C-All_Department - Total',!Entity,'All Counter Comp','CL ALL',!Currency,!t_Months,!t_Scenario,'Dollars')
						,CONTINUE);

FEEDERS;
['USD'] => ['EUR'];
['EUR', {'AZUR', 'EARTH'}] => ['USD'];
['USD'] => ['CNY'];
['CNY', {'MHC'}] => ['USD'];
['Actuals'] => ['Forecast'];
