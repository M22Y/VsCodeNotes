[{'2013', '2014', '2015', '2016', '2017', '2018' }] = N: 0;

## 30

## ============================================================================= OLD
#[ {'Budget', 'Forecast', 'Budget_Final'} ] = N: IF ( ATTRS('Manning_Job', !Manning_Job , 'Code_Fonction') @= '##NA##', 0, CONTINUE);
## ============================================================================= OLD

['Total_Hrs_Paid',{'Forecast',  'Rolling_Fct_Adj'}]= N:
	IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1, ['Actual'], CONTINUE);

##**************2018-06-14 MART New Call Center manning
['Job-Retail', {'Budget', 'Forecast', 'Rolling_Fct_Adj'} ] = S: IF ( (AttrS( 'Manning_Job', !Manning_Job, 'Short Desc') @= DB('30_Manning_by_Employee', !Org_Structure, !Employee, !Versions, !t_Years, !t_Months, 'Job-Retail') %
		 AttrS( 'Manning_Job', !Manning_Job, 'Short Desc') @= DB('30_Manning_by_Employee', !Org_Structure, !Employee, !Versions, !t_Years, !t_Months, 'Job-Vanfax') %
 			AttrS( 'Manning_Job', !Manning_Job, 'Short Desc') @= DB('30_Manning_by_Employee', !Org_Structure, !Employee, !Versions, !t_Years, !t_Months, 'Job-Call_Center'))
	& ATTRS('Manning_Job', !Manning_Job , 'Code_Fonction') @<> '' ,
	DB('30_Manning_by_Employee', !Org_Structure, !Employee, !Versions, !t_Years, !t_Months, 'Job-Retail'), '');

