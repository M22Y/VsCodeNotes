###************2018-06-14 MR correction formules
['Total_Hrs_Paid', 'Actual' ] = N: DB('38_Manning_Actuals', !Org_Structure, !Employee, 'C' | !t_Years | '-' | !t_Months , !Manning_Job, 'Paid', !Versions, 'unite');
['Total_Hrs', 'Actual' ] = N: DB('38_Manning_Actuals', !Org_Structure, !Employee, 'C' | !t_Years | '-' | !t_Months , !Manning_Job, 'Total_Codes_Codes', !Versions, 'unite');
#['Job-Retail', 'Actual' ] = S:DB('38_Manning_Actuals', !Org_Structure, !Employee, 'C' | !t_Years | '-' | !t_Months , !Manning_Job, 'Total_Jobs', !Versions, 'Job-Retail');
['Rate_Hrs', 'Actual'] = N: DB('38_Manning_Actuals', !Org_Structure, !Employee, 'C' | !t_Years | '-' | !t_Months , !Manning_Job, 'Total_codes', !Versions, 'taux');
['Salary_Impact$', 'Actual'] = N: DB('38_Manning_Actuals', !Org_Structure, !Employee, 'C' | !t_Years | '-' | !t_Months , !Manning_Job, 'Total_Codes', !Versions, 'montant');

['Head_Count', 'Actual' ] =  N:IF (['Total_Hrs'] <> 0 , 1, 0);
['Head_Count', 'Total_Months'] = (['Jan'] + ['Feb'] + ['Mar'] + ['Apr'] + ['May'] + ['Jun'] + ['Jul'] + ['Aug']+ ['Sep'] + ['Oct'] + ['Nov'] + ['Dec']) \
(['Jan']\['Jan'] + ['Feb']\['Feb'] + ['Mar']\['Mar'] + ['Apr']\['Apr'] + ['May']\['May'] + ['Jun']\['Jun'] + ['Jul']\['Jul'] + ['Aug']\['Aug']+ ['Sep']\['Sep'] + ['Oct']\['Oct'] + ['Nov']\['Nov'] + ['Dec']\['Dec']);




['Total_Hrs'] = N: IF ( ['Total_Hrs_Paid' ] >0, ['Total_Hrs_Paid' ] , ['Number_Week' ] * ['Reg_Week_Hrs' ]);

['Total_Efficiency%', {'Budget', 'Forecast', 'Rolling_Fct_Adj'} ] = N: IF( ['Reg_Week_Hrs'] = 0, 0,
						IF( SCAN('MANAGER', DB('33_Manning_Time_Available', !Org_Structure, !Employee, !Manning_Job, !Versions, !t_Years, !t_Months, 'Job-Retail') ) > 0,
						DB('32_Manning_Assump', !Org_Structure, !Versions, !t_Years, 'Total_Manager_Indirect_Efficiency%'),
						IF(SCAN('CUSTOMER SERV', DB('33_Manning_Time_Available', !Org_Structure, !Employee, !Manning_Job, !Versions, !t_Years, !t_Months, 'Job-Retail') ) >0,
							DB('32_Manning_Assump', !Org_Structure, !Versions, !t_Years, 'Total_CSR_Indirect_Efficiency%'),1)));

['Total_Std_Reg_Salary$' ] = N: ['Salary$'] * ['Total_Efficiency%'] ;
['Total_Std_Reg_Fringe$' ] = N: ['Fringes%_Impact$' ] * ['Total_Efficiency%'] ;
['Total_Std_Hrs'] = N: ['Total_Hrs'] * ['Total_Efficiency%'] ;

['Work_to_Total_ratio%'] = IF( ['Reg_Week_Hrs'] = 0, 0,
	DB('33_Manning_Time_Available', !Org_Structure, 'Total', 'Total_Jobs', !Versions, !t_Years, !t_Months, 'Total_Std_Hrs')\
						DB('33_Manning_Time_Available', !Org_Structure, 'Total', 'Total_Jobs', !Versions, !t_Years, !t_Months, 'Total_Hrs'));

['Efficiency_Variation_for_Period%'] = N: DB('39_Manning_Efficiency_Variation_by_Period', !Org_Structure, !Versions, !t_Years, !t_Months, 'Efficiency_Variation_for_Period%');

['Std_Hrs_Efficiency_Variation_Impact' ] = N: ['Total_Std_Hrs'] * ['Efficiency_Variation_for_Period%' ];

#C level Calcs
#************2018-06-14 MR
['Rate_Hrs','Actual']= C:  ['Salary$'] \ (['Total_Hrs_Paid']);

['Rate_Hrs']= C:  ['Salary$'] \ (['Number_Week_Calc'] * ['Reg_Week_Hrs']);
['Fringes%'] = C: ['Fringes%_Impact$']\ ['Salary$'] ;
['Increase%'] = C: ['Increase%_Impact$']\(['Salary_Impact$'] + ['Increase$_Impact$']);
['Bonus%']  = C: ['Bonus%_Impact$']\(['Salary_Impact$'] + ['Increase$_Impact$'] + ['Increase%_Impact$']);
['Comission%'] = C: ['Comission%_Impact$']\(['Salary_Impact$'] + ['Increase$_Impact$'] + ['Increase%_Impact$']);
['Total_Efficiency%'] = C: ['Total_Std_Hrs']\['Total_Hrs']  ;
['Efficiency_Variation_for_Period%' ] = C: ['Std_Hrs_Efficiency_Variation_Impact' ] \ ['Total_Std_Hrs'] ;


['Reg_Week_Hrs_Calc', 'Total_Months','Total_Jobs'] = (['Jan'] + ['Feb'] + ['Mar'] + ['Apr'] + ['May'] + ['Jun'] + ['Jul'] + ['Aug']+ ['Sep'] + ['Oct'] + ['Nov'] + ['Dec']) \
(['Jan']\['Jan'] + ['Feb']\['Feb'] + ['Mar']\['Mar'] + ['Apr']\['Apr'] + ['May']\['May'] + ['Jun']\['Jun'] + ['Jul']\['Jul'] + ['Aug']\['Aug']+ ['Sep']\['Sep'] + ['Oct']\['Oct'] + ['Nov']\['Nov'] + ['Dec']\['Dec']);


['Reg_Week_Hrs_Calc'] =  N: ['Reg_Week_Hrs'] \ ['Head_Count'];
['Reg_Week_Hrs_Calc', 'Total' ] =  C: ['Reg_Week_Hrs'] \ ['Head_Count'];

['Number_Week', 'Total_Months'] = (['Jan'] + ['Feb'] + ['Mar'] + ['Apr'] + ['May'] + ['Jun'] + ['Jul'] + ['Aug']+ ['Sep'] + ['Oct'] + ['Nov'] + ['Dec']) \
(['Jan']\['Jan'] + ['Feb']\['Feb'] + ['Mar']\['Mar'] + ['Apr']\['Apr'] + ['May']\['May'] + ['Jun']\['Jun'] + ['Jul']\['Jul'] + ['Aug']\['Aug']+ ['Sep']\['Sep'] + ['Oct']\['Oct'] + ['Nov']\['Nov'] + ['Dec']\['Dec']);

['Number_Week_Calc', 'Total_Months'] = (['Jan'] + ['Feb'] + ['Mar'] + ['Apr'] + ['May'] + ['Jun'] + ['Jul'] + ['Aug']+ ['Sep'] + ['Oct'] + ['Nov'] + ['Dec']) \
(['Jan']\['Jan'] + ['Feb']\['Feb'] + ['Mar']\['Mar'] + ['Apr']\['Apr'] + ['May']\['May'] + ['Jun']\['Jun'] + ['Jul']\['Jul'] + ['Aug']\['Aug']+ ['Sep']\['Sep'] + ['Oct']\['Oct'] + ['Nov']\['Nov'] + ['Dec']\['Dec']);


['Number_Week_Calc'] =   ['Number_Week'] \ ['Head_Count'];


###++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
FEEDERS;


#[{'Total_Hrs_Paid', 'Number_Week', 'Reg_Week_Hrs'} ] => ['Total_Hrs'] ;
[{ 'Number_Week', 'Reg_Week_Hrs'} ] => ['Total_Hrs'] ;
['Total_Hrs_Paid'] => ['Total_Hrs'] ;
['Total_Hrs'] => ['Total_Std_Hrs'], ['Total_Efficiency%'] , ['Work_to_Total_ratio%' ] , ['Rate_Hrs' ] , ['Head_Count', 'Actual'];
['Total_Efficiency%'] => ['Total_Hrs']  ;
['Total_Hrs', 'Actual'] => ['Salary_Impact$' ] ;
['Reg_Week_Hrs'] => ['Reg_Week_Hrs_Calc'];
['Number_Week'] => ['Number_Week_Calc'];
['Total_Hrs'] => ['Head_Count_Calc'];


['Total_Hrs_Paid', 'Actual'] => ['Forecast'],
			[ 'Rolling_Fct_Adj'];

##
##  Feeding 32 (assumptions) since  no hours = no usefull assumptions
##

['Total_Hrs'] => DB('32_Manning_Assump', !Org_Structure, !Versions, !t_Years, 'OVT_Rate');
['Total_Hrs'] => DB( '32_Manning_Assump', !Org_Structure, !Versions, !t_Years, 'Manager_Indirect_Efficiency%');
['Total_Hrs'] => DB( '32_Manning_Assump', !Org_Structure, !Versions, !t_Years, 'CSR_Indirect_Efficiency%');
['Total_Hrs'] => DB( '32_Manning_Assump', !Org_Structure, !Versions, !t_Years, 'OVT_Convert%'),
			DB('35_Manning_Output_FTE', !Org_Structure, !Versions, !t_Years, !t_Months, 'Reg_Hrs');



['Total_Std_Hrs' ] => DB('35_Manning_Output_FTE', !Org_Structure, !Versions, !t_Years, !t_Months, 'Total_Std_Hrs_Available'), ['Total_Std_Reg_Salary$' ], ['Efficiency_Variation_for_Period%' ], ['Total_Std_Reg_Fringe$' ];

['Total_Std_Reg_Salary$' ] => DB('35_Manning_Output_FTE', !Org_Structure, !Versions, !t_Years, !t_Months, 'Reg_Work_Salary$');
['Total_Std_Reg_Fringe$' ] => DB('35_Manning_Output_FTE', !Org_Structure, !Versions, !t_Years, !t_Months, 'Fringe_Work$');
['Salary$'] => DB('35_Manning_Output_FTE', !Org_Structure, !Versions, !t_Years, !t_Months, 'Reg_Salary$');
['Fringes%_Impact$' ] => DB('35_Manning_Output_FTE', !Org_Structure, !Versions, !t_Years, !t_Months, 'Fringe$');

['Work_to_Total_ratio%' ] => DB('35_Manning_Output_FTE', !Org_Structure, !Versions, !t_Years, !t_Months, 'Work_to_Total_ratio%');
['Efficiency_Variation_for_Period%' ]  => ['Std_Hrs_Efficiency_Variation_Impact' ] ;
['Std_Hrs_Efficiency_Variation_Impact' ] => ['Efficiency_Variation_for_Period%' ] , DB('35_Manning_Output_FTE', !Org_Structure, !Versions, !t_Years, !t_Months, 'Std_Hrs_Efficiency_Variation_Impact_Available') ;


