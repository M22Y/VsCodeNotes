SKIPCHECK;
FEEDSTRINGS;

########################################################################
########################################################################
## DESCRIPTION
#
#  RUX for cube 11_SalesCOS_NonPrime
#
#
#
#
## HISTORIQUE
#
# 2021-07-02 Claude-Sebastien JEAN   Ajout Baseline 2022
# 2021-07-26 Claude-Sebastien JEAN   Changement ordre des produits Glass_Reated (wipers etc9.)
# 2021-07-31 Claude-Sebastien JEAN   Delete des regles de GM% forcee.
# 2023-09-03 Youssef M. (RCGT)   Net sales not null for division - row 390
#
#
########################################################################
########################################################################


#Stet historical year Budget and Forecast
['Forecast', {'2009', '2010', '2011', '2012', '2013', '2014', '2015'}]= N: STET;
['Budget', {'2009', '2010', '2011', '2012', '2013', '2014', '2015', '2016'}]= N: STET;

#Lines won't never be use in the Cube 11
[{'BuyOut$','Inventory_Revaluation$','Exchange_Rate$_Impact', 'Unrealized_Profit_on_Trans$'} ] = 0;

#MART 11-07-2018 Put lines at zero, can't be in the $GM
[{'PPV$', 'Breakage$'}, {'Forecast', 'Budget', 'Rolling_Fct_Adj'} ]=N: 0;


#Products not use
[{'Auto_Laminated_Glass', 'Tinted_Glass'}] =N: 0;

#MR To do after the budget 2017 has been trsf to Budget Final segments freeze
#[{'Insurance', 'Cash', 'Trade', 'Fleet', 'No_Segment'}] =N:
#	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @= 'WH', 0, CONTINUE);
#[{'Interne', 'APPLE_FR', 'LEBEAU_FR', 'DURO_FR', 'STD_FR', 'NOVUS_FR', 'ISP', 'Commercial_EXT', 'Other_EXT', 'Grossiste', 'No_Segment_EXT'}] =N:
#	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH', 0, CONTINUE);
#['Franchise_Customer']= N: 0;

#Freeze lines if your are Retail
[{'Sales_Inc_Dec$', 'Sales_Inc_Dec%', 'GM%_Revised'}, {'Wipers', 'Aquapel', 'Disposal_Fees', 'Cabin_Filter'}]= N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH', 0, CONTINUE);

#Freeze lines if your are Not Retail
['Glass_Related_Sales$', {'Forecast', 'Budget', 'Rolling_Fct_Adj'}] =N:
IF (ELPAR('Products_Detailed', !Products_Detailed, 1) @<> 'Glass_Related_Products', 0, CONTINUE);

#To put at 0 Forecast month with Flag 1
[{'Forecast', 'Rolling_Fct_Adj'}, {'Economic%','Advertising%','Weather%','Reinspection_Other%','Inc_Dec_Units','Conversion_Units','Trsf_units','Prime_Units_Glass_Related_Consumer',
'Replacement_Units_Glass_Related','Price_Impact%','Deductible_Wave%','Product_Mix%','ASP_Other$','AAC_Inc_Dec$','AAC_Inc_Dec%', 'Sales_Inc_Dec$', 'Sales_Inc_Dec%', 'GM%_Revised', 'Glass_Related_Sales%', 'Glass_Related_Units_Adjusted'} ]=
	IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1, 0, CONTINUE);

#To freeze all COS$ for product that don't have GL Line for costs
[{'PPV$','Breakage$'}, {'Labour_Flat_Glass','Flat_Glass_Commission','Remove&Reinstall','Alcometer','Disposal_Fees'}, {'Forecast', 'Budget', 'Rolling_Fct_Adj'}]=N:0;
[{'PPV$','Breakage$'}, 'Interne', {'Forecast', 'Budget', 'Rolling_Fct_Adj'}]=N:0;
['GM%_Revised', {'Labour_Flat_Glass','Flat_Glass_Commission','Remove&Reinstall','Alcometer','Disposal_Fees'}, {'Forecast', 'Budget', 'Rolling_Fct_Adj'}]=N:1;

#Budget 2013 initialisation of Data from Planning - set baselines to 0
[{'Units_Baseline','AIP_Baseline','Sales_Baseline','Material_Cost_Baseline','GM%_Baseline'}, 'Budget', '2013']= N:0;


#Replace Prime_Units_Glass_Related_Consumer by Base Line
['AIP_Baseline', 'Actual',{'Wipers', 'Aquapel', 'Disposal_Fees', 'Cabin_Filter'}]=N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH', (['Net_Sales'])\ ['Prime_Units_Glass_Related_Consumer'], CONTINUE);
['Material_Cost_Baseline', 'Actual',  {'Wipers', 'Aquapel', 'Disposal_Fees', 'Cabin_Filter'}]=N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH', (['COS$'])\ ['Prime_Units_Glass_Related_Consumer'], CONTINUE);

#Forecast & Budget GLass Related Units
['Prime_Units_Glass_Related_Consumer', {'Wipers','Aquapel', 'Cabin_Filter'}, {'Insurance', 'Cash'}, {'Forecast', 'Budget', 'Rolling_Fct_Adj'}]= N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH',
		DB('10_SalesCOS', !Org_Structure, 'Total_Prime', !Customer_Segments, !Versions, !t_Years, !t_Months, 'Total_Units'),0);
['Prime_Units_Glass_Related_Consumer', 'Disposal_Fees', {'Insurance', 'Cash', 'Fleet', 'Trade'}, {'Forecast', 'Budget', 'Rolling_Fct_Adj'}]= N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH',
		DB('10_SalesCOS', !Org_Structure, 'Replacement', !Customer_Segments, !Versions, !t_Years, !t_Months, 'Total_Units'),0);

['Glass_Related_Units_Adjusted', {'Disposal_Fees','Wipers', 'Aquapel', 'Cabin_Filter'}, {'Forecast', 'Budget', 'Rolling_Fct_Adj'}] =N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH', ['Prime_Units_Glass_Related_Consumer']* ['Glass_Related_Sales%'],0);

['Glass_Related_Sales$', {'Forecast', 'Budget', 'Rolling_Fct_Adj'}, {'Disposal_Fees','Wipers','Aquapel', 'Cabin_Filter'}]=N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH', ['Glass_Related_Units_Adjusted']* ['ASP_Other$'],0);

# Forecast month close
['COS$_Pure', {'Forecast', 'Rolling_Fct_Adj'}] = N:
	IF(ATTRS('Products_Detailed', !Products_Detailed, 'isNonPrime') @= 'Y',
		IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1, ['Actual', 'COS$_Pure'], CONTINUE), 0);


['COS$_Pure', {'Forecast', 'Budget', 'Rolling_Fct_Adj'}, {'Disposal_Fees','Wipers','Aquapel', 'Cabin_Filter'}]=N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH', ['Glass_Related_Units_Adjusted']* ['AAC_Inc_Dec$'], CONTINUE);

['COS$_Pure', {'Forecast', 'Budget', 'Rolling_Fct_Adj'} ]=N: ['Net_Sales']-['GM$'];


########################Sales$#################
#Actual - Sales Baseline External
['Sales_Baseline', 'No_Segment', 'Actual' ]= N:
	IF(ATTRS('Products_Detailed', !Products_Detailed, 'isNonPrime') @= 'Y' &ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH',
		-DB('84_Actuals_GL', !Org_Structure, ATTRS('Products_Detailed', !Products_Detailed, 'GL_External_Sales'), !Versions, !t_Years, !t_Months, 'Dollars$'),0);
['Sales_Baseline', 'No_Segment_EXT', 'Actual' ]= N:
	IF(ATTRS('Products_Detailed', !Products_Detailed, 'isNonPrime') @= 'Y' &ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @= 'WH',
		-DB('84_Actuals_GL', !Org_Structure, ATTRS('Products_Detailed', !Products_Detailed, 'GL_External_Sales'), !Versions, !t_Years, !t_Months, 'Dollars$'),0);
#Actual - Sales Baseline Internal
['Sales_Baseline', 'Interne', 'Actual']= N: IF(ATTRS('Products_Detailed', !Products_Detailed, 'isNonPrime') @= 'Y',
	-DB('84_Actuals_GL', !Org_Structure, ATTRS('Products_Detailed', !Products_Detailed, 'GL_Interco_Sales'), !Versions, !t_Years, !t_Months, 'Dollars$'),0);

#Belron will use TRSF Pricing with budget start year 2014
#Mart 07-17-2014 Add Fct to Transf Pricing
[{'Sales_Inc_Dec$', 'Sales_Inc_Dec%', 'Material_Cost_Baseline', 'AAC_Inc_Dec$', 'AAC_Inc_Dec%', 'BuyOut_Units', 'Inventory_Revaluation_Units', 'Exchange_Rate_Units', 'PPV_Units', 'Breakage_Units',  'GM%_Baseline', 'GM%_Revised'}, 'Interne',
 'Glass_Accessories', {'Budget', 'Forecast', 'Rolling_Forecast'}] =N: 0;


##===========================================================================
##-----------------------------------------------------
## 2021-07-02 CSJ
## New Rules Starting FORECAST 2011 and BUDGET 2022.
##-----------------------------------------------------

##Order changed to make sure that this is 1st.
# Baseline @0 pour Glass_Rel_Products always
['Sales_Baseline', {'Forecast', 'Rolling_Fct_Adj', 'Budget'}, {'Disposal_Fees','Wipers','Aquapel', 'Cabin_Filter'}] = N:
	IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
		['Actual', 'Net_Sales'],
		IF(ATTRS('Org_Structure_Leaf', !Org_Structure, 'SB_Code') @= 'WH', CONTINUE, 0));


['Sales_Baseline', 'Forecast'] =N:
	IF(!t_Years @>= '2021',
		IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
			['Actual', 'Net_Sales'],
			# IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @= 'WH',
			DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Actual', ATTRS('t_Years', !t_Years, 'Prev_Yr'), !t_Months, 'Net_sales')
				# , CONTINUE)
			)
		, CONTINUE);

['Sales_Baseline', 'Budget'] =N:
	IF(!t_Years @>= '2022',
		# IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @= 'WH',
			DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Forecast', ATTRS('t_Years', !t_Years, 'Prev_Yr'), !t_Months, 'Net_sales')
			# , CONTINUE)
		, CONTINUE);


##===========================================================================



['Sales_Baseline', 'Interne', 'Glass_Accessories', {'Forecast', 'Rolling_Fct_Adj'}] =N:
	IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
		['Actual', 'Net_Sales'],
				IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @= 'WH',
			DB('13_Internal_Transfer', !Org_Structure, !Products_Detailed, !Customer_Segments, !Versions, !t_Years, !t_Months, 'Net_Sales'),0));

['Sales_Baseline', 'Interne', 'Glass_Accessories', 'Budget'] =N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @= 'WH',
		DB('13_Internal_Transfer', !Org_Structure, !Products_Detailed, !Customer_Segments, !Versions, !t_Years, !t_Months, 'Net_Sales'),0);

['Sales_Baseline', 'Forecast']= N:
	IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
		['Actual', 'Net_Sales'],
		DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Budget', !t_Years, !t_Months, 'Net_sales'));

#Start in 2015
['Sales_Baseline', 'Rolling_Fct_Adj', '2015']= N:
	IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
		['Actual', 'Net_Sales'],
		DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Budget', !t_Years, !t_Months, 'Net_sales'));

['Sales_Baseline', 'Rolling_Fct_Adj']= N:
	IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
		['Actual', 'Net_Sales'],
		DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, !Versions, ATTRS('t_Years', !t_Years, 'Prev_Yr'), !t_Months, 'Net_sales'));

##---------------------------------------------------------------------------------------------------------------------------------------------------------------------
##BUDGET 2021 SEULEMENT
['Sales_Baseline', 'Budget', '2021']= N:
	DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Budget', '2020', !t_Months, 'Net_sales');
##---------------------------------------------------------------------------------------------------------------------------------------------------------------------

##Mart new Budget base line start in 2014 Forecast_5_7
['Sales_Baseline', 'Budget']= N:
	DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Forecast_6_6', ATTRS('t_Years', !t_Years, 'Prev_Yr'), !t_Months, 'Net_sales');

#Calcul Sales INC_DEC$ et INC_DEC% Impact
['Sales_Inc_Dec%_Impact$', {'Forecast', 'Budget', 'Rolling_Fct_Adj'}]= N:
		IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1, 0, ['Sales_Baseline']*['Sales_Inc_Dec%']);

#So 20/06/2013 :: % consolidé selon la memem memthode.. .voir Martin selon priorité
['Sales_Inc_Dec%'] =C:0;

########################COS$#################
#Actual - External COS$
['COS$_Pure', 'No_Segment', 'Actual']= N: IF(ATTRS('Products_Detailed', !Products_Detailed, 'isNonPrime') @= 'Y',
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH',
		DB('84_Actuals_GL', !Org_Structure, ATTRS('Products_Detailed', !Products_Detailed, 'GL_External_COS'), !Versions, !t_Years, !t_Months, 'Dollars$'),0),
		CONTINUE);
['COS$_Pure', 'No_Segment_EXT', 'Actual']= N: IF(ATTRS('Products_Detailed', !Products_Detailed, 'isNonPrime') @= 'Y',
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @= 'WH',
		DB('84_Actuals_GL', !Org_Structure, ATTRS('Products_Detailed', !Products_Detailed, 'GL_External_COS'), !Versions, !t_Years, !t_Months, 'Dollars$'),0),
		CONTINUE);
#Actual - Internal COS$
['COS$_Pure', 'Interne', 'Actual']= N: IF(ATTRS('Products_Detailed', !Products_Detailed, 'isNonPrime') @= 'Y',
	DB('84_Actuals_GL', !Org_Structure, ATTRS('Products_Detailed', !Products_Detailed, 'GL_Interco_COS'), !Versions, !t_Years, !t_Months, 'Dollars$'),0);



##===========================================================================
##-----------------------------------------------------
## 2021-07-02 CSJ
## New Rules Starting FORECAST 2011 and BUDGET 2022.
##-----------------------------------------------------

['PPV$', {'No_Segment_EXT', 'No_Segment'}, 'Forecast']= N:
	IF(!t_Years @>= '2021',
		IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
			['Actual', 'PPV$'],
			DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Actual', ATTRS('t_Years', !t_Years, 'Prev_Yr'), !t_Months, 'PPV$'))
		, CONTINUE);


['Breakage$', {'No_Segment_EXT', 'No_Segment'}, 'Forecast']= N:
	IF(!t_Years @>= '2021',
		IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
			['Actual', 'Breakage$'],
			DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Actual', ATTRS('t_Years', !t_Years, 'Prev_Yr'), !t_Months, 'Breakage$'))
		, CONTINUE);

##===========================================================================




########################OTHER COS$#################c
#Actual - External OTHER COS$ - PPV$
['PPV$', 'No_Segment', 'Actual']= N: IF(ATTRS('Products_Detailed', !Products_Detailed, 'isNonPrime') @= 'Y',
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH',
		DB('84_Actuals_GL', !Org_Structure, ATTRS('Products_Detailed', !Products_Detailed, 'GL_PPV'), !Versions, !t_Years, !t_Months, 'Dollars$'),0),
		CONTINUE);


['PPV$', 'No_Segment_EXT', 'Actual']= N: IF(ATTRS('Products_Detailed', !Products_Detailed, 'isNonPrime') @= 'Y',
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @= 'WH',
		DB('84_Actuals_GL', !Org_Structure, ATTRS('Products_Detailed', !Products_Detailed, 'GL_PPV'), !Versions, !t_Years, !t_Months, 'Dollars$'),0),
		CONTINUE);

['PPV$', {'No_Segment_EXT', 'No_Segment'}, {'Forecast', 'Rolling_Fct_Adj'}]= N:
	IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
		['Actual', 'PPV$'],
		CONTINUE);

#Actual - External OTHER COS$ - BREAKAGE$
['Breakage$', 'No_Segment', 'Actual']= N: IF(ATTRS('Products_Detailed', !Products_Detailed, 'isNonPrime') @= 'Y',
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH',
		DB('84_Actuals_GL', !Org_Structure, ATTRS('Products_Detailed', !Products_Detailed, 'GL_BRKG'), !Versions, !t_Years, !t_Months, 'Dollars$'),0),
		CONTINUE);
['Breakage$', 'No_Segment_EXT', 'Actual']= N: IF(ATTRS('Products_Detailed', !Products_Detailed, 'isNonPrime') @= 'Y',
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @= 'WH',
		DB('84_Actuals_GL', !Org_Structure, ATTRS('Products_Detailed', !Products_Detailed, 'GL_BRKG'), !Versions, !t_Years, !t_Months, 'Dollars$'),0),
		CONTINUE);

['Breakage$', {'No_Segment_EXT', 'No_Segment'}, {'Forecast', 'Rolling_Fct_Adj'}]= N:
	IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
		['Actual', 'Breakage$'],
		CONTINUE);

#####################################COST & Gross Margin######################



##===========================================================================
##-----------------------------------------------------
## 2021-07-02 CSJ
## New Rules Starting FORECAST 2011 and BUDGET 2022.
##-----------------------------------------------------

['GM%_Baseline', 'Forecast']= N:
	IF(!t_Years @>= '2021',
		IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
			['Actual', 'GM%'],
			DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Actual', ATTRS('t_Years', !t_Years, 'Prev_Yr'), !t_Months, 'GM%'))
		, CONTINUE);

['GM%_Baseline', 'Budget']= N:
	IF(!t_Years @>= '2022',
		DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Forecast', ATTRS('t_Years', !t_Years, 'Prev_Yr'), !t_Months, 'GM%')
		, CONTINUE
	);

##===========================================================================


# Baseline @0 pour Glass_Rel_Products always
['GM%_Baseline', {'Disposal_Fees','Wipers','Aquapel', 'Cabin_Filter'}, {'Forecast', 'Budget', 'Rolling_Fct_Adj'}] = N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @= 'WH', CONTINUE, 0);

['GM%_Baseline', 'Forecast']= N:
	IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
		['Actual', 'GM%'],
		DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Budget', !t_Years, !t_Months, 'GM%'));

['GM%_Baseline', 'Rolling_Fct_Adj', '2015']= N:
	IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
		['Actual', 'GM%'],
		DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Budget', !t_Years, !t_Months, 'GM%'));

['GM%_Baseline', 'Rolling_Fct_Adj']= N:
	IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
		['Actual', 'GM%'],
		DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, !Versions, ATTRS('t_Years', !t_Years, 'Prev_Yr'), !t_Months, 'GM%'));


##---------------------------------------------------------------------------------------------------------------------------------------------------------------------
##BUDGET 2021 SEULEMENT
['GM%_Baseline', 'Budget', '2021']= N:
	DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Budget', '2020', !t_Months, 'GM%');
##---------------------------------------------------------------------------------------------------------------------------------------------------------------------

##Mart new Budget base line start in 2014 Forecast_5_7
['GM%_Baseline', 'Budget']= N:
	DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Forecast_5_7', ATTRS('t_Years', !t_Years, 'Prev_Yr'), !t_Months, 'GM%');

#Calcul Gross Margin %


##===========================================================================
##-----------------------------------------------------
## 2021-07-02 CSJ
## New Rules Starting FORECAST 2011 and BUDGET 2022.
##-----------------------------------------------------
['GM$', 'Forecast']=N:
	IF(!t_Years @>= '2021',
		IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
			['Actual', 'GM$'], ['Net_Sales'] * ['GM%'])
		, CONTINUE);

['GM$', 'Budget']=N:
	IF(!t_Years @>= '2022',
		['Net_Sales'] * ['GM%']
		, CONTINUE);

##===========================================================================


['GM$', 'Actual'] =N: ['Net_Sales']- ['COS$'];

['GM$', {'Forecast', 'Budget', 'Rolling_Fct_Adj'}, {'Wipers', 'Aquapel', 'Disposal_Fees', 'Cabin_Filter'} ] =N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH',
		 ['Net_Sales']- ['COS$'], CONTINUE);

['GM$', {'Forecast', 'Rolling_Fct_Adj'}]=N:
	IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
		['Actual', 'GM$'], ['Net_Sales'] * ['GM%']);

['GM$', 'Budget']=N: ['Net_Sales'] * ['GM%'];




#
# ##===========================================================================
# ##-----------------------------------------------------
# ## 2021-07-02 CSJ
# ## New Rules Starting FORECAST 2011 and BUDGET 2022.
# ##-----------------------------------------------------
#
# ['GM%', 'Forecast']= N:
# 	IF(!t_Years @>= '2021',
# 		IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
# 			['Actual', 'GM%'],
# 			DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Actual', ATTRS('t_Years', !t_Years, 'Prev_Yr'), !t_Months, 'GM%'))
# 		, CONTINUE);
