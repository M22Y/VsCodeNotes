['Net_Sales','Actual']=> DB( '11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Forecast', ATTRS('t_Years', !t_Years, 'Next_yr'), !t_Months, 'Sales_Baseline');
['Net_Sales','Forecast']=> DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Budget', ATTRS('t_Years', !t_Years, 'Next_yr'), !t_Months, 'Sales_Baseline');

[{'PPV$', 'Breakage$'},'Actual']=> DB( '11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Forecast', ATTRS('t_Years', !t_Years, 'Next_yr'), !t_Months, !m_SalesCOS);
[{'PPV$', 'Breakage$'}, 'Forecast']=> DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Budget', ATTRS('t_Years', !t_Years, 'Next_yr'), !t_Months, !m_SalesCOS);


['GM%','Actual']=> DB( '11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Forecast', ATTRS('t_Years', !t_Years, 'Next_yr'), !t_Months, 'GM%_Baseline');
['GM%','Forecast']=> DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Budget', ATTRS('t_Years', !t_Years, 'Next_yr'), !t_Months, 'GM%_Baseline');

