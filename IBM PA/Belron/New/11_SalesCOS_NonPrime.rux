# 		DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Forecast', ATTRS('t_Years', !t_Years, 'Prev_Yr'), !t_Months, 'GM%')
# 		, CONTINUE
# 	);
#
# ##===========================================================================



['GM%', {'Forecast', 'Budget', 'Rolling_Fct_Adj'}, {'Wipers', 'Aquapel', 'Disposal_Fees', 'Cabin_Filter'} ] =N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH' 
      & DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, !Versions, !t_Years, !t_Months, 'Net_Sales') <> 0,
		['GM$'] \ ['Net_Sales'], CONTINUE);

#['GM%', {'Forecast', 'Budget', 'Rolling_Fct_Adj'}, {'Wipers', 'Aquapel', 'Disposal_Fees', 'Cabin_Filter'} ] =N:
#	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH',
#		['GM$'] \ ['Net_Sales'], CONTINUE);

['GM%', {'Forecast', 'Budget', 'Rolling_Fct_Adj'}] =N: IF(['GM%_Revised']<>0,
		['GM%_Revised'],['GM%_Baseline']);

['GM%'] = ['GM$'] \ ['Net_Sales'];

#So 20/06/2013 :: % consolidé selon la memem memthode.. .voir Martin selon priorité
[{'GM%_Revised', 'GM%_Baseline'}] =C:0;

#To freeze the input lines for Actual scenario
[{'BuyOut$', 'Inventory_Revaluation$', 'Exchange_Rate$_Impact',
 'Sales_Inc_Dec$', 'Sales_Inc_Dec%', 'Sales_Inc_Dec%_Impact$', 'GM%_Revised', 'Glass_Related_Sales%', 'ASP_Other$'}, 'Actual']= 0;

['Total_Other_Sales_Excl_Glass_Related'] = ['Other_Sales' ] - ['Calibration_Camera' ] ;


###+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
FEEDERS;

['Prime_Units_Glass_Related_Consumer', 'Actual'] => ['AIP_Baseline'], ['Material_Cost_Baseline'];


['Sales_Baseline'] => DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, !Versions, !t_Years, !t_Months, 'Sales_Inc_Dec%_Impact$');

['COS$', 'Actual']=> DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Actual', !t_Years, !t_Months, 'GM$');
['COS$', {'Forecast', 'Budget', 'Rolling_Fct_Adj'}, {'Wipers', 'Aquapel', 'Disposal_Fees', 'Cabin_Filter'}] => DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, !Versions, !t_Years, !t_Months, 'GM$');


['Prime_Units_Glass_Related_Consumer', {'Forecast', 'Budget', 'Rolling_Fct_Adj'}]=>
	DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, !Versions, !t_Years, !t_Months, 'Glass_Related_Units_Adjusted'),
	DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, !Versions, !t_Years, !t_Months, 'Glass_Related_Sales$');

['Prime_Units_Glass_Related_Consumer', {'Forecast', 'Budget', 'Rolling_Fct_Adj'} , {'Disposal_Fees','Wipers','Aquapel', 'Cabin_Filter'}]=>	DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments,
	!Versions, !t_Years, !t_Months, 'COS$_Pure');

['Total_Units', 'Windshield', 'Retail', {'Forecast', 'Budget', 'Rolling_Fct_Adj'}]=>
	DB('11_SalesCOS_NonPrime', !Org_Structure, 'Glass_Accessories', 'Interne', !Versions, !t_Years, !t_Months, 'COS$_Pure');
['Net_Sales', {'Forecast', 'Budget', 'Rolling_Fct_Adj'}]=> DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, !Versions, !t_Years, !t_Months, 'COS$_Pure');
['Net_Sales']=> DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, !Versions, !t_Years, !t_Months, 'GM%_Baseline'),
			DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, !Versions, !t_Years, !t_Months, 'GM%_Revised');
['Net_Sales'] => DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, !Versions, !t_Years, !t_Months, 'GM$'),
				DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, !Versions, !t_Years, !t_Months, 'GM%');


['PPV$', 'Actual']=> DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Forecast', !t_Years, !t_Months, 'PPV$') ;
['Breakage$', 'Actual']=> DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Forecast', !t_Years, !t_Months, 'Breakage$');

['Net_Sales','Actual']=> DB( '11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Forecast', !t_Years, !t_Months, 'Sales_Baseline');
['Net_Sales','Forecast_6_6']=> DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Budget', STR(NUMBR(!t_Years)+1,4,0), !t_Months, 'Sales_Baseline');
['Net_Sales','Budget']=> DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Forecast', !t_Years, !t_Months, 'Sales_Baseline');

['Net_Sales','Budget', '2015']=> DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Rolling_Fct_Adj', !t_Years, !t_Months, 'Sales_Baseline');
['Net_Sales','Actual']=> DB( '11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Rolling_Fct_Adj', !t_Years, !t_Months, 'Sales_Baseline');
['Net_Sales','Rolling_Fct_Adj']=> DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, !Versions, STR(NUMBR(!t_Years)+1,4,0), !t_Months, 'Sales_Baseline');

['Net_Sales','Actual', {'Disposal_Fees','Wipers','Aquapel', 'Cabin_Filter'}]=>
	DB( '11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Budget', !t_Years, !t_Months, 'Sales_Baseline');

['GM%','Actual']=>
	DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Forecast', !t_Years, !t_Months, 'GM%_Baseline');
['GM%','Forecast_5_7']=>
	DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Budget', STR(NUMBR(!t_Years)+1,4,0), !t_Months, 'GM%_Baseline');
['GM%','Budget']=>
	DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Forecast', !t_Years, !t_Months, 'GM%_Baseline');

['COS$_Pure', 'Actual'] => 	DB('11_SalesCOS_NonPrime', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Forecast', !t_Years, !t_Months, 'COS$_Pure');
['GM$', 'Actual']=> ['GM$', 'Forecast'];

[{'Forecast', 'Budget', 'Rolling_Fct_Adj'}, 'COS$_Pure']=>  DB('85_ETL_Stats', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'COS$');
[{'Forecast', 'Budget', 'Rolling_Fct_Adj'}, 'PPV$']=>  DB('85_ETL_Stats', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'PPV$');
[{'Forecast', 'Budget', 'Rolling_Fct_Adj'}, 'Breakage$']=>  DB('85_ETL_Stats', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Breakage$');
[{'Forecast', 'Budget', 'Rolling_Fct_Adj'}, 'BuyOut$']=>  DB('85_ETL_Stats', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'BuyOut$');
[{'Forecast', 'Budget', 'Rolling_Fct_Adj'}, 'Inventory_Revaluation$']=>  DB('85_ETL_Stats', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Inventory_Revaluation$');
[{'Forecast', 'Budget', 'Rolling_Fct_Adj'}, 'Exchange_Rate$_Impact']=>  DB('85_ETL_Stats', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Exchange_Rate$_Impact');

[{'Forecast', 'Budget', 'Rolling_Fct_Adj'}, 'Net_Sales']=>  DB('85_ETL_Stats', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Sales$');


