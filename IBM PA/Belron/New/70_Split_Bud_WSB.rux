t_Months, !m_Split_Bud_WSB);
['%_PPV$_Calc'] = C: ConsolidatedAvg(2, '', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, !m_Split_Bud_WSB);
['%_PPV$_Overwrite_Adj', {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Sales_Discounts', 'Deductibles'}] = C: ConsolidatedAvg(2, '', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, !m_Split
_Bud_WSB);
['%_Breakage$_Calc', {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Sales_Discounts', 'Deductibles'}] = C: ConsolidatedAvg(2, '', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, !m_Split_Bud
_WSB);
['%_Breakage$_Overwrite_Adj', {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Sales_Discounts', 'Deductibles'}] = C: ConsolidatedAvg(2, '', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, !m_
Split_Bud_WSB);


