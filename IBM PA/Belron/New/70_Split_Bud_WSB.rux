##############################################################
#Retail & Vanfax Branch calculation Sales Units base on last year % AR (regional) level
['Sales_Units_Calc', {'Forecast', 'Budget', 'Budget_Final'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] = N:
['Units_Baseline', 'Windshield'] * ['%_Units_Calc'];

#Retail Branch calculation Sales $ base on last year % AR (regional) level
['Sales$_Calc', {'Budget', 'Budget_Final','Forecast'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Sales_Discounts', 'Deductibles', 'Kits_Retail'}] = N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH',
		(['Sales$_Baseline', 'Windshield'] * ['%_Sales$_Calc']), CONTINUE);

#Vanfax Branch calculation Sales $ base on last year % AR (regional) level
['Sales$_Calc', {'Budget', 'Budget_Final','Forecast'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] = N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @= 'WH',
		((['Sales$_Baseline','Windshield'] + ['Sales$_Baseline','Side'] + ['Sales$_Baseline','Back'] + ['Sales$_Baseline','RV_Glass'] + ['Sales$_Baseline','Bus_Glass']) * ['%_Sales$_Calc']), CONTINUE);

#Retail & Vanfax Branch calculation COS$ base on last year % AR (regional) level
#Mart 2015-31-08 Excluded Kits Retail
['COS$_Calc', {'Budget', 'Budget_Final','Forecast'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] = N:
		(['COS$_Baseline','Windshield']  * ['%_COS$_Calc']);
['BuyOut$_Calc', {'Budget', 'Budget_Final','Forecast'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] = N:
		(['BuyOut$_Baseline', 'Windshield'] * ['%_BuyOut$_Calc']);
['Inventory_Revaluation$_Calc', {'Budget', 'Budget_Final','Forecast'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] = N:
		(['Inventory_Revaluation$_Baseline', 'Windshield'] * ['%_Inventory_Revaluation$_Calc']);
['PPV$_Calc', {'Budget', 'Budget_Final','Forecast'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] = N:
		(['PPV$_Baseline', 'Windshield'] * ['%_PPV$_Calc']);
['Breakage$_Calc', {'Budget', 'Budget_Final','Forecast'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] = N:
		(['Breakage$_Baseline', 'Windshield'] * ['%_Breakage$_Calc']);



################################################################
#Branch calculation Sales Units with overwrite adj. In the case of it has no historic
['Sales_Units', {'Budget', 'Budget_Final','Forecast'},  {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Sales_Discounts', 'Deductibles', 'Kits_Retail'}] =N:
	IF((['%_Units_Overwrite_Adj', 'Replacement']=0 & ['%_Units_Calc', 'Replacement']=0), ['Units_Baseline'],
		IF(['%_Units_Overwrite_Adj']<>0, (['Units_Baseline', 'Windshield'] * ['%_Units_Overwrite_Adj']),['Sales_Units_Calc']));

#Retail manual Adj
['Sales$', {'Budget', 'Budget_Final','Forecast'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Sales_Discounts', 'Deductibles', 'Kits_Retail'}] =N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH',
		IF((['%_Sales$_Overwrite_Adj', 'Replacement']=0 & ['%_Sales$_Calc', 'Replacement']=0), ['Sales$_Baseline'],
			IF(['%_Sales$_Overwrite_Adj']<>0, (['Sales$_Baseline', 'Windshield'] * ['%_Sales$_Overwrite_Adj']), ['Sales$_Calc'])), CONTINUE);

#Vanfax manual Adj
['Sales$', {'Budget', 'Budget_Final','Forecast'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] =N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @= 'WH',
		IF((['%_Sales$_Overwrite_Adj', 'Replacement']=0 & ['%_Sales$_Calc', 'Replacement']=0), ['Sales$_Baseline'],
			IF(['%_Sales$_Overwrite_Adj']<>0, (['Sales$_Baseline','Windshield'] * ['%_Sales$_Overwrite_Adj']), ['Sales$_Calc'])), CONTINUE);

#Retail and Vanfax COS$ manual Adj
#Mart 2015-31-08 Excluded Kits Retail
['COS$', {'Budget', 'Budget_Final','Forecast'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] =N:
	IF((['%_COS$_Overwrite_Adj', 'Replacement']=0 & ['%_COS$_Calc', 'Replacement']=0), ['COS$_Baseline'],
		IF(['%_COS$_Overwrite_Adj']<>0, (['COS$_Baseline', 'Windshield'] * ['%_COS$_Overwrite_Adj']),['COS$_Calc']));

['BuyOut$', {'Budget', 'Budget_Final','Forecast'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] =N:
	IF((['%_BuyOut$_Overwrite_Adj', 'Replacement']=0 & ['%_BuyOut$_Calc', 'Replacement']=0), ['BuyOut$_Baseline'],
		IF(['%_BuyOut$_Overwrite_Adj']<>0, (['BuyOut$_Baseline', 'Windshield'] * ['%_BuyOut$_Overwrite_Adj']),['BuyOut$_Calc']));

['Inventory_Revaluation$', {'Budget', 'Budget_Final','Forecast'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] =N:
	IF((['%_Inventory_Revaluation$_Overwrite_Adj', 'Replacement']=0 & ['%_Inventory_Revaluation$_Calc', 'Replacement']=0), ['Inventory_Revaluation$_Baseline'],
		IF(['%_Inventory_Revaluation$_Overwrite_Adj']<>0, (['Inventory_Revaluation$_Baseline', 'Windshield'] * ['%_Inventory_Revaluation$_Overwrite_Adj']),['Inventory_Revaluation$_Calc']));

['PPV$', {'Budget', 'Budget_Final','Forecast'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] =N:
	IF((['%_PPV$_Overwrite_Adj', 'Replacement']=0 & ['%_PPV$_Calc', 'Replacement']=0), ['PPV$_Baseline'],
		IF(['%_PPV$_Overwrite_Adj']<>0, (['PPV$_Baseline', 'Windshield'] * ['%_PPV$_Overwrite_Adj']),['PPV$_Calc']));

['Breakage$', {'Budget', 'Budget_Final','Forecast'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] =N:
	IF((['%_Breakage$_Overwrite_Adj', 'Replacement']=0 & ['%_Breakage$_Calc', 'Replacement']=0), ['Breakage$_Baseline'],
		IF(['%_Breakage$_Overwrite_Adj']<>0, (['Breakage$_Baseline', 'Windshield'] * ['%_Breakage$_Overwrite_Adj']),['Breakage$_Calc']));


##Total line
['Total_Units'] = ['Sales_Units'];
['Total_Sales$'] =['Sales$'];
['Total_COS'] = ['Total_COS$'] + ['Total_BuyOut$'] + ['Total_Inv_Revaluation$'] + ['Total_PPV$'] + ['Total_Breakage$'];
['Total_COS$'] = ['COS$'];
['Total_BuyOut$'] = ['BuyOut$'];
['Total_Inv_Revaluation$'] = ['Inventory_Revaluation$'];
['Total_PPV$'] = ['PPV$'];
['Total_Breakage$'] = ['Breakage$'];

