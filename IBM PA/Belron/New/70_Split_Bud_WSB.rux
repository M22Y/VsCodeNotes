#Stet
['Actual', {'2010', '2011', '2012'}]= STET;
[{'Budget', 'Budget_Final'}, {'2010', '2011', '2012', '2013', '2014'}]= STET;
[{'Forecast', 'Rolling_Fct_Adj'}, {'2010', '2011', '2012', '2013'}]= STET;

#Put at zero
#Only Prime
[] =N: IF(ATTRS('Products_Detailed', !Products_Detailed, 'isNonPrime') @= 'Y', 0, CONTINUE);

#MART 2015-09-02  problem stats with 8450 Stats were recorded under Whs Segement
[{'Sales_Units',  'Sales$', 'COS$', 'BuyOut$', 'Inventory_Revaluation$', 'PPV$', 'Breakage$'}, 'Actual', { 'Interne', 'APPLE_FR','LEBEAU_FR', 'DURO_FR', 'STD_FR',  'NOVUS_FR', 'ISP',  'Commercial_EXT', 'Other_EXT',  'Grossiste'} ] =N:
	IF(ATTRS('Org_Structure_Leaf', !Org_Structure, 'SB_Code') @<> 'WH',  0, CONTINUE);

[{'%_Units', '%_Sales$', '%_COS$', '%_BuyOut$', '%_Inventory_Revaluation$', '%_PPV$', '%_Breakage$'}] = N: 0;

[{'Sales_Discounts', 'Deductibles'}, {'Forecast', 'Budget', 'Budget_Final'}, {'%_Units_Calc', 'Sales_Units_Calc', '%_Units_Overwrite_Adj', '%_COS$_Calc', 'COS$_Calc', '%_COS$_Overwrite_Adj', '%_BuyOut$_Calc', 'BuyOut$_Calc', '%_BuyOut$_Overwrite_Adj',
'%_Inventory_Revaluation$_Calc', 'Inventory_Revaluation$_Calc', '%_Inventory_Revaluation$_Overwrite_Adj','%_PPV$_Calc', 'PPV$_Calc', '%_PPV$_Overwrite_Adj',  '%_Breakage$_Calc', 'Breakage$_Calc', '%_Breakage$_Overwrite_Adj'}] = N: 0;

#Flag = 1 Actual = Forecast
 [{'Sales_Units', 'Sales$', 'COS$', 'BuyOut$', 'Inventory_Revaluation$', 'PPV$', 'Breakage$'}, 'Forecast', {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Sales_Discounts', 'Deductibles', 'Kits_Retail', 'Repairs'}]= N:
	 IF(DB('97_Actual_Flags', !t_Years, !t_Months, 'Forecast')=1,
		 ['Actual'], CONTINUE);


 ['Forecast', {'Units_Baseline', '%_Units', '%_Units_Calc', 'Sales_Units_Calc', '%_Units_Overwrite_Adj', 'Sales$_Baseline', '%_Sales$', '%_Sales$_Calc', 'Sales$_Calc', '%_Sales$_Overwrite_Adj', 'COS$_Baseline', '%_COS$', '%_COS$_Calc'
, 'COS$_Calc', '%_COS$_Overwrite_Adj', 'BuyOut$_Baseline', '%_BuyOut$', '%_BuyOut$_Calc', 'BuyOut$_Calc', '%_BuyOut$_Overwrite_Adj', 'Inventory_Revaluation$_Baseline', '%_Inventory_Revaluation$', '%_Inventory_Revaluation$_Calc', 'Inventory_Revaluation$_Ca
lc', '%_Inventory_Revaluation$_Overwrite_Adj', 'PPV$_Baseline', '%_PPV$', '%_PPV$_Calc', 'PPV$_Calc', '%_PPV$_Overwrite_Adj', 'Breakage$_Baseline', '%_Breakage$', '%_Breakage$_Calc', 'Breakage$_Calc', '%_Breakage$_Overwrite_Adj'}, {'Windshield', 'Side', '
Back', 'RV_Glass', 'Bus_Glass', 'Sales_Discounts', 'Deductibles', 'Kits_Retail', 'Repairs'}]= N:
	 IF(DB('97_Actual_Flags', !t_Years, !t_Months, 'Forecast')=1, 0, CONTINUE);


#Baseline from cube 85
['Units_Baseline', {'Forecast', 'Budget', 'Budget_Final'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Sales_Discounts', 'Deductibles', 'Kits_Retail' , 'Repairs'}] = N:
	DB('85a_ETL_Stats', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Sales_units');

['Sales$_Baseline', {'Forecast', 'Budget', 'Budget_Final'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Sales_Discounts', 'Deductibles', 'Kits_Retail', 'Repairs'}] = N:
	DB('85a_ETL_Stats', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Sales$');

['COS$_Baseline', {'Forecast', 'Budget', 'Budget_Final'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Kits_Retail', 'Repairs'}] = N:
	DB('85a_ETL_Stats', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'COS$');

['BuyOut$_Baseline', {'Forecast', 'Budget', 'Budget_Final'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Kits_Retail', 'Repairs'}] = N:
	DB('85a_ETL_Stats', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'BuyOut$');

['Inventory_Revaluation$_Baseline', {'Forecast', 'Budget', 'Budget_Final'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Kits_Retail', 'Repairs'}] = N:
	DB('85a_ETL_Stats', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Inventory_Revaluation$');

['PPV$_Baseline', {'Forecast', 'Budget', 'Budget_Final'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Kits_Retail', 'Repairs'}] = N:
	DB('85a_ETL_Stats', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'PPV$');

['Breakage$_Baseline', {'Forecast', 'Budget', 'Budget_Final'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Kits_Retail', 'Repairs'}] = N:
	DB('85a_ETL_Stats', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Breakage$');

#Repairs
['Repairs',  {'Forecast', 'Budget', 'Budget_Final'}, 'Sales_Units'] = N:
	IF(ATTRS('Org_Structure_Leaf', !Org_Structure, 'SB_Code') @= 'WH', 0, ['Units_Baseline']);
['Repairs', {'Forecast', 'Budget', 'Budget_Final'}, 'Sales$'] = N:
	IF(ATTRS('Org_Structure_Leaf', !Org_Structure, 'SB_Code') @= 'WH', 0, ['Sales$_Baseline']);
[{'Repairs', 'Kits_Retail'}, {'Forecast', 'Budget', 'Budget_Final'}, 'COS$'] = N:
	IF(ATTRS('Org_Structure_Leaf', !Org_Structure, 'SB_Code') @= 'WH', 0, ['COS$_Baseline']);
[{'Repairs', 'Kits_Retail'}, {'Forecast', 'Budget', 'Budget_Final'}, 'BuyOut$'] = N:
	IF(ATTRS('Org_Structure_Leaf', !Org_Structure, 'SB_Code') @= 'WH', 0, ['BuyOut$_Baseline']);
[{'Repairs', 'Kits_Retail'}, {'Forecast', 'Budget', 'Budget_Final'}, 'Inventory_Revaluation$'] = N:
	IF(ATTRS('Org_Structure_Leaf', !Org_Structure, 'SB_Code') @= 'WH', 0, ['Inventory_Revaluation$_Baseline']);
[{'Repairs', 'Kits_Retail'}, {'Forecast', 'Budget', 'Budget_Final'}, 'PPV$'] = N:
	IF(ATTRS('Org_Structure_Leaf', !Org_Structure, 'SB_Code') @= 'WH', 0, ['PPV$_Baseline']);
[{'Repairs', 'Kits_Retail'}, {'Forecast', 'Budget', 'Budget_Final'}, 'Breakage$'] = N:
	IF(ATTRS('Org_Structure_Leaf', !Org_Structure, 'SB_Code') @= 'WH', 0, ['Breakage$_Baseline']);

['Repairs',  {'Forecast', 'Budget', 'Budget_Final'}, {'%_Units_Calc', 'Sales_Units_Calc', '%_Units_Overwrite_Adj', '%_Sales$_Calc', 'Sales$_Calc','%_Sales$_Overwrite_Adj', '%_COS$_Calc', 'COS$_Calc', '%_COS$_Overwrite_Adj', '%_BuyOut$_Calc', 'BuyOut$_Ca
lc', '%_BuyOut$_Overwrite_Adj', '%_Inventory_Revaluation$_Calc', 'Inventory_Revaluation$_Calc', '%_Inventory_Revaluation$_Overwrite_Adj','%_PPV$_Calc', 'PPV$_Calc', '%_PPV$_Overwrite_Adj',  '%_Breakage$_Calc', 'Breakage$_Calc', '%_Breakage$_Overwrite_Adj'
}] = N: 0;
#Mart 2015-31-08 Added Buy_Out, Inv_Adj, PPV, Breakage Kits Retail
['Kits_Retail', {'Forecast', 'Budget', 'Budget_Final'}, {'%_COS$_Calc', 'COS$_Calc', '%_COS$_Overwrite_Adj', '%_BuyOut$_Calc', 'BuyOut$_Calc', '%_BuyOut$_Overwrite_Adj', '%_Inventory_Revaluation$_Calc',
'Inventory_Revaluation$_Calc', '%_Inventory_Revaluation$_Overwrite_Adj', '%_PPV$_Calc', 'PPV$_Calc', '%_PPV$_Overwrite_Adj', '%_Breakage$_Calc', 'Breakage$_Calc', '%_Breakage$_Overwrite_Adj'}] = N: 0;

#Vanfax Sales Discount & Deductibles
[{'Sales_Discounts', 'Deductibles'}, {'Forecast', 'Budget', 'Budget_Final'}, 'Sales$'] = N:
	IF(ATTRS('Org_Structure_Leaf', !Org_Structure, 'SB_Code') @= 'WH', ['Sales$_Baseline'], CONTINUE);

[{'Sales_Discounts', 'Deductibles'}, {'Forecast', 'Budget', 'Budget_Final'}, {'%_Sales$_Calc', 'Sales$_Calc','%_Sales$_Overwrite_Adj'}] = N:
		IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @= 'WH', 0, CONTINUE);

#############################################################
#Retail & Vanfax Calculation % Units
['%_Units',{'Actual', 'Forecast'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] = C:
	['Sales_Units'] \ (['Sales_Units','Windshield'] + ['Sales_Units','Side'] + ['Sales_Units','Back'] + ['Sales_Units','RV_Glass'] + ['Sales_Units','Bus_Glass']);

#Retail Calculation % Sales$
['%_Sales$', {'Actual', 'Forecast'}, {'Retail', 'Consumer', 'Insurance', 'B2B', 'Cash', 'Trade', 'Fleet', 'No_Segment'}, {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Sales_Discounts', 'Deductibles', 'Kits_Retail'}] = C:
		['Sales$'] \ ['Sales$', 'Replacement'];

#Vanfax Calculation % Sales$
['%_Sales$', {'Actual', 'Forecast'}, {'Vanfax', 'Interne', 'Externe', 'APPLE_FR', 'LEBEAU_FR', 'DURO_FR', 'STD_FR', 'NOVUS_FR', 'ISP', 'Commercial_EXT', 'Other_EXT', 'Grossiste', 'No_Segment_Ext'}, {'Windshield', 'Side', 'Back', 'RV_Gla
ss', 'Bus_Glass'}] = C: 	['Sales$'] \  (['Sales$','Windshield'] + ['Sales$','Side'] + ['Sales$','Back'] + ['Sales$','RV_Glass'] + ['Sales$','Bus_Glass']);

###Only one time for the Rolling FCt (colud be delete after 2015, will use Budget_Final as reference)
