#####################################
#Mart 2015-31-08 Excluded Kits Retail
#Retail & Vanfax Calculation COS$
['%_COS$', {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] = C:
		['COS$'] \ (['COS$','Windshield'] + ['COS$','Side'] + ['COS$','Back'] + ['COS$','RV_Glass'] + ['COS$','Bus_Glass']);

['%_BuyOut$', {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] = C:
		['BuyOut$'] \ (['BuyOut$','Windshield'] + ['BuyOut$','Side'] + ['BuyOut$','Back'] + ['BuyOut$','RV_Glass'] + ['BuyOut$','Bus_Glass']);

['%_Inventory_Revaluation$', {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] = C:
		['Inventory_Revaluation$'] \ (['Inventory_Revaluation$','Windshield'] + ['Inventory_Revaluation$','Side'] + ['Inventory_Revaluation$','Back'] + ['Inventory_Revaluation$','RV_Glass'] + ['Inventory_Revaluation$','Bus_Glass']);

['%_PPV$', {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] = C:
		['PPV$'] \ (['PPV$','Windshield'] + ['PPV$','Side'] + ['PPV$','Back'] + ['PPV$','RV_Glass'] + ['PPV$','Bus_Glass']);

['%_Breakage$', {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] = C:
		['Breakage$'] \ (['Breakage$','Windshield'] + ['Breakage$','Side'] + ['Breakage$','Back'] + ['Breakage$','RV_Glass'] + ['Breakage$','Bus_Glass']);


#############################################################
#%_Units_Overwrite if it has no last year historic we take one level higher for org struct and segments father
['%_Units_Overwrite_Adj', 'Forecast', {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] =N:
	If(['%_Units_Calc', 'Replacement'] =0,
	DB('70_Split_bud_WSB', ATTRS('Org_Structure',!Org_Structure, 'OT_Level'), ATTRS('Customer_Segments', !Customer_Segments, 'Level_1'), !Products_Detailed, 'Actual', STR(NUMBR(!t_Years)-1,4,0), !t_Months, '%_Units'),0);


