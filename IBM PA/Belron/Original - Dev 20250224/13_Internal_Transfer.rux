['Net_Sales', 'Interne', 'Glass_Accessories', {'Forecast', 'Budget', 'Rolling_Fct_Adj'}] =>
DB('11_SalesCOS_NonPrime', ELPAR('Org_Structure_WH', !Org_Structure_WH, 1), !Products_Detailed, !Customer_Segments, !Versions, !t_Years, !t_Months, 'Sales_Baseline'),
DB('11_SalesCOS_NonPrime', ELPAR('Org_Structure_WH', !Org_Structure_WH, 1), !Products_Detailed, !Customer_Segments, !Versions, !t_Years, !t_Months, 'COS$_Pure');
