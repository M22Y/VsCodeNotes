## 2014-02-03  CSJ Ajout du parent au lieu du Org_Structure_WH tout seul.
['ASP', 'Windshield',  'Interne', {'Forecast', 'Budget', 'Rolling_Fct_Adj'}] => DB('10_SalesCOS', ELPAR('Org_Structure_WH', !Org_Structure_WH, 1), !Products_Detailed, !Customer_Segments, !Versions, !t_Years, !t_Months,'AIP_Baseline');


