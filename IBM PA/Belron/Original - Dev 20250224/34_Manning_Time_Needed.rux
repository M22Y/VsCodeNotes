###############################FEEDERS#######################################################################
FEEDERS;

['Units_Replacement'] => ['Total_Std_Hrs_Replacement_per_Unit_Calc'];
['Units_Repair'] => ['Total_Std_Hrs_Repair_per_Unit_Calc'];
['Total_Std_Hrs_Flat_Glass'] => ['$_Flat_Glass_per_Std_Hrs_Calc'];
['Total_Std_Hrs_Alco'] => ['$_Alcometer_per_Std_Hrs_Calc'];
['Total_Std_Hrs_Other'] => ['$_Other_Sales_per_Std_Hrs_Calc'];


['Units_Replacement', {'Actual', 'Budget', 'Forecast', 'Rolling_Fct_Adj'}] => DB( IF(ATTRS('Org_Structure', !Org_Structure, 'SB_Code')@= 'WH', '', '34_Manning_Time_Needed'), !Org_Structure, !Versions, !t_Years, !t_Months, 'Total_Std_Hrs_Replacement'),
					['Total_Std_Hrs_Replacement_per_Unit' ],
					DB('32_Manning_Assump', !Org_Structure, !Versions, !t_Years, 'Total_Std_Hrs_Replacement_per_Unit'),
					DB('32_Manning_Assump', !Org_Structure, !Versions, !t_Years, 'Hrs_per_FTE') ;

['Units_Repair', {'Actual', 'Budget', 'Forecast', 'Rolling_Fct_Adj'}] => DB( IF(ATTRS('Org_Structure', !Org_Structure, 'SB_Code')@= 'WH', '', '34_Manning_Time_Needed'), !Org_Structure, !Versions, !t_Years, !t_Months, 'Total_Std_Hrs_Repair'),
					['Total_Std_Hrs_Repair_per_Unit' ],
					DB('32_Manning_Assump', !Org_Structure, !Versions, !t_Years, 'Total_Std_Hrs_Repair_per_Unit') ,
					DB('32_Manning_Assump', !Org_Structure, !Versions, !t_Years, 'Hrs_per_FTE') ;

['Sales$_Flat_Glass', {'Actual', 'Budget', 'Forecast', 'Rolling_Fct_Adj'}] => DB( IF(ATTRS('Org_Structure', !Org_Structure, 'SB_Code')@= 'WH', '', '34_Manning_Time_Needed'), !Org_Structure, !Versions, !t_Years, !t_Months, 'Total_Std_Hrs_Flat_Glass' ), ['T
otal_Std_Hrs_NonPrime' ] ,
					DB('32_Manning_Assump', !Org_Structure, !Versions, !t_Years, 'Hrs_per_FTE') ;

['Sales$_Flat_Glass', {'Actual', 'Budget', 'Forecast', 'Rolling_Fct_Adj'}] => DB( IF(ATTRS('Org_Structure', !Org_Structure, 'SB_Code')@= 'WH', '', '34_Manning_Time_Needed'), !Org_Structure, !Versions, !t_Years, !t_Months, '$_Flat_Glass_per_Std_Hrs' );

['Sales$_Alcometer', {'Actual', 'Budget', 'Forecast', 'Rolling_Fct_Adj'}]  => DB( IF(ATTRS('Org_Structure', !Org_Structure, 'SB_Code')@= 'WH', '', '34_Manning_Time_Needed'), !Org_Structure, !Versions, !t_Years, !t_Months, 'Total_Std_Hrs_Alco') , ['Total_S
td_Hrs_NonPrime' ] ,
					DB('32_Manning_Assump', !Org_Structure, !Versions, !t_Years, 'Hrs_per_FTE') ;

['Sales$_Alcometer', {'Actual', 'Budget', 'Forecast', 'Rolling_Fct_Adj'}]  => DB( IF(ATTRS('Org_Structure', !Org_Structure, 'SB_Code')@= 'WH', '', '34_Manning_Time_Needed'), !Org_Structure, !Versions, !t_Years, !t_Months, '$_Alcometer_per_Std_Hrs');

['Sales$_Other_Sales', {'Actual', 'Budget', 'Forecast', 'Rolling_Fct_Adj'}] => DB( IF(ATTRS('Org_Structure', !Org_Structure, 'SB_Code')@= 'WH', '', '34_Manning_Time_Needed'), !Org_Structure, !Versions, !t_Years, !t_Months, 'Total_Std_Hrs_Other' ), ['Total
_Std_Hrs_NonPrime' ] ,
					DB('32_Manning_Assump', !Org_Structure, !Versions, !t_Years, 'Hrs_per_FTE') ;

['Sales$_Other_Sales', {'Actual', 'Budget', 'Forecast', 'Rolling_Fct_Adj'}] => DB( IF(ATTRS('Org_Structure', !Org_Structure, 'SB_Code')@= 'WH', '', '34_Manning_Time_Needed'), !Org_Structure, !Versions, !t_Years, !t_Months, '$_Other_Sales_per_Std_Hrs' ) ;

['Total_Std_Hrs_Prime', {'Actual', 'Budget', 'Forecast', 'Rolling_Fct_Adj'}]  => DB('35_Manning_Output_FTE', !Org_Structure, !Versions, !t_Years, !t_Months, 'Total_Std_Hrs_Prime_Needed');

['Total_Std_Hrs_Flat_Glass', {'Actual', 'Budget', 'Forecast', 'Rolling_Fct_Adj'}] => DB('35_Manning_Output_FTE', !Org_Structure, !Versions, !t_Years, !t_Months, 'Total_Std_Hrs_Flat_Glass_Needed');

['Total_Std_Hrs_Alco', {'Actual', 'Budget', 'Forecast', 'Rolling_Fct_Adj'}] => DB('35_Manning_Output_FTE', !Org_Structure, !Versions, !t_Years, !t_Months, 'Total_Std_Hrs_Alco_Needed');

['Total_Std_Hrs_Other', {'Actual', 'Budget', 'Forecast', 'Rolling_Fct_Adj'}] => DB('35_Manning_Output_FTE', !Org_Structure, !Versions, !t_Years, !t_Months, 'Total_Std_Hrs_Other_Needed');

['Total_Std_Hrs_Needed', {'Actual', 'Budget', 'Forecast', 'Rolling_Fct_Adj'}] => DB('35_Manning_Output_FTE', !Org_Structure, !Versions, !t_Years, !t_Months, 'Hrs_per_FTE'), DB('35_Manning_Output_FTE', !Org_Structure, !Versions, !t_Years, !t_Months, 'Total
_OVT_Convert%');
