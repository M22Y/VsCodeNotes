['Dollars$_Baseline', 'Actual', '5027', 'wk05', 'D7']= N:
	If(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '5',
		-DB('84_Actuals_GL', !Org_Structure, '000160', !Versions, !t_Years, !t_Months, 'Dollars$')
