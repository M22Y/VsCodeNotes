	\ DB('68_DailySales_GL_Std', !Org_Structure, !GL_Accounts, !Versions, !t_Years, !t_Months, !t_weeks, 'All_Days', 'Baseline_Std_Adj');

['%_Dollars$', {'Budget', 'Forecast', 'Budget_Final'}, 'wk05'] =N:
