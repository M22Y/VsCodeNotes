# Delete all years before 2019.
[{'2013', '2014', '2015', '2016', '2017', '2018' }] = N: 0;

# 
#Stet
['Actual', {'2011', '2012', '2013'}]= 0;
[{'Budget', 'Forecast', 'Budget_Final'}, {'2011', '2012', '2013'}]= 0;
[{'Forecast', 'Rolling_Fct_Adj'}, {'2011', '2012', '2013'}]= 0;


#Measures at 0
[{'Baseline_Std', 'Holiday', 'Baseline_Std_Adj', '%_Dollars$', 'Dollars$_to_Spread'}, 'Actual'] = N: 0;

#[{'Budget', 'Forecast', 'Budget_Final'}, 'Dollars$_Inc_Dec_Adj'] = N: 0;
#[{'Forecast', 'Rolling_Fct_Adj'}, 'Dollars$_Inc_Dec_Adj'] = N:
#	IF (DB('97_Daily_Sales_Actual_Flags', !Versions, !t_Years, !t_Months, !t_Weeks, !t_Days) = 1, ['Actual'],0);

#Prime is comming from Cube 67 Stats
[{'3810U', '3811', '6065G', '4120'}, {'Baseline_Std', 'Holiday', 'Baseline_Std_Adj', '%_Dollars$', 'Dollars$_to_Spread'}, {'Budget', 'Forecast', 'Budget_Final'}] = N: 0;

#Put 0 Child of Royalties excluding 3930 (Accrual)
['Dollars$_Baseline', 'Actual', {'3930B', '3930A','3930m'}] =N: 0;

#Put 0 Child of Sales Discounts excluding 4951 (Accrual)
['Dollars$_Baseline', 'Actual', {'3205A', '3210A', '3250A', '3805A', '3810A', '3811A', '3850A', '4213', '4302A', '4303', '4312', '4312A', '4313', '4313A', '4313B', '4313C', '4319', '4322', '4322A', '4323', '4327', '4332', '4332A', '4333', '4342', '4342A',
 '4343', '4352', '4352A', '4353', '4372', '4372A', '4373', '4382', '4382A', '4383', '4402', '4403', '4404', '4950', '4950A', '4950B', '4950L', '4950M', '4950N', '4950O', '4950P', '4950Q', '4950R', '4950S', '4951', '4951A', '4952A', '4952B', '4952L', '4952
R', '4952V', '4953', '4953A', '4958', '6011G', '6055G', '6056G'}] = N: 0;

#Put 0 Child of Avis Revenues
[{'3931', '3931A', '3931B', '3931C', '3931D', '3931E', '3931F', '3931G'}]= N: 0;

['Dollars$_Baseline', 'Actual', '3931H', 'wk04']= N:
	If(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '5', 0, CONTINUE);
['Dollars$_Baseline', 'Actual', '3931H', 'wk05']= N:
	If(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '4', 0, CONTINUE);

['Dollars$_Baseline', 'Actual', '3931H', 'wk05', {'D1', 'D2', 'D3', 'D4', 'D5', 'D6'}]= N:
	If(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '5', 0, CONTINUE);
['Dollars$_Baseline', 'Actual', '3931H', 'wk04', {'D1', 'D2', 'D3', 'D4', 'D5', 'D6'}]= N:
	If(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '4', 0, CONTINUE);
['3931H', 'Actual', { 'WK01', 'WK02', 'WK03'}]= N: 0;

#Put 0 Revenues Dealer Prog
['Dollars$_Baseline', 'Actual', '3932', 'wk04']= N:
	If(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '5', 0, CONTINUE);
['Dollars$_Baseline', 'Actual', '3932', 'wk05']= N:
	If(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '4', 0, CONTINUE);

['Dollars$_Baseline', 'Actual', '3932', 'wk05', {'D1', 'D2', 'D3', 'D4', 'D5', 'D6'}]= N:
	If(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '5', 0, CONTINUE);
['Dollars$_Baseline', 'Actual', '3932', 'wk04', {'D1', 'D2', 'D3', 'D4', 'D5', 'D6'}]= N:
	If(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '4', 0, CONTINUE);
['3932', 'Actual', { 'WK01', 'WK02', 'WK03'}]= N: 0;




#Variation Version calculation
['Var%_Act-Bud'] = (['Actual'] - ['Budget']) \ ['Budget'];
['Var%_Act-Bud_Final'] = (['Actual'] - ['Budget_Final']) \ ['Budget_Final'];
#['Var%_Act-Rolling_Fct'] = (['Actual'] - ['Rolling_Forecast']) \ ['Rolling_Forecast'];
#['Var%_Rolling_Fct-Bud_Final'] = (['Rolling_Forecast'] - ['Budget_Final']) \ ['Budget_Final'];

['Var_Act-LY'] = IF (DB('97_Daily_Sales_Actual_Flags', !Versions, !t_Years, !t_Months, !t_Weeks, !t_Days) = 0, 0,
	['Actual'] - DB('68_DailySales_GL_Std', !Org_Structure, !GL_Accounts, 'Actual', STR(NUMBR(!t_Years)-1,4,0), !t_Months, !t_Weeks, !t_Days, !m_ETL_GL_Daily_Std));

['Var%_Act-LY'] = IF (DB('97_Daily_Sales_Actual_Flags', !Versions, !t_Years, !t_Months, !t_Weeks, !t_Days) = 0, 0,
	(['Actual'] - DB('68_DailySales_GL_Std', !Org_Structure, !GL_Accounts, 'Actual', STR(NUMBR(!t_Years)-1,4,0), !t_Months, !t_Weeks, !t_Days, !m_ETL_GL_Daily_Std))
	 \ DB('68_DailySales_GL_Std', !Org_Structure, !GL_Accounts, 'Actual', STR(NUMBR(!t_Years)-1,4,0), !t_Months, !t_Weeks, !t_Days, !m_ETL_GL_Daily_Std));


#################################
#LY Full Year not link to Flag
['Dollars$_All_Year', {'Actual', 'Budget', 'Forecast', 'Budget_Final'}] = N: ['Dollars$_Baseline'] + ['Dollars$_Inc_Dec_Adj'] ;


#################################
#Flag to show Budget and LY data only if it has an actual data
['Dollars$'] = N: IF (DB('97_Daily_Sales_Actual_Flags', !Versions, !t_Years, !t_Months, !t_Weeks, !t_Days) = 0,0, CONTINUE);


##################################
#Reverse Accrual Royalties last day of the week base on Actual of the month
['Other_Income_Accrual', 'Actual', {'3930', '3930B', '3930A','3930m'}, 'wk05', 'D7'] =N:
	if(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '5', 0 ,CONTINUE);

['Other_Income_Accrual', 'Actual', {'3930', '3930B', '3930A','3930m'}, 'wk04', 'D7'] =N:
	if(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '4', 0 ,CONTINUE);

['Other_Income_Accrual', 'Actual', {'3930', '3930B', '3930A','3930m'}]= N: ['Dollars$'];

#Reverse Accrual Sales Discounts last day of the week base on Actual of the month
['Other_Income_Accrual', 'Actual', '6065G', 'wk05', 'D7'] =N:
	if(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '5', 0 ,CONTINUE);

['Other_Income_Accrual', 'Actual', '6065G', 'wk04', 'D7'] =N:
	if(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '4', 0 ,CONTINUE);

['Other_Income_Accrual', 'Actual', '6065G']= N: ['Dollars$'];

#Reverse Accrual Deductibles last day of the week base on Actual of the month
['Other_Income_Accrual', 'Actual', '5027', 'wk05', 'D7'] =N:
	if(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '5', 0 ,CONTINUE);

['Other_Income_Accrual', 'Actual', '5027', 'wk04', 'D7'] =N:
	if(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '4', 0 ,CONTINUE);

['Other_Income_Accrual', 'Actual', '5027']= N: ['Dollars$'];

#Reverse Accrual 000310 Call CTR Service Fees JE adj
['Other_Income_Accrual', 'Actual', {'3501', '3502', '3503', '3504'}, 'wk05', 'D7'] =N:
	if(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '5', 0 ,CONTINUE);

['Other_Income_Accrual', 'Actual', {'3501', '3502', '3503', '3504'}, 'wk04', 'D7'] =N:
	if(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '4', 0 ,CONTINUE);

['Other_Income_Accrual', 'Actual', {'3501', '3502', '3503', '3504'}]= N: ['Dollars$'];


#Put 0 for Accrual measure for all other GL than Royalties and Sales Discounts
['Other_Income_Accrual'] =N: 0;

################
#Actual
#Bring Royalties from 68_DailySales_GL_Std Last Day, Last Week minus Accrual
['Dollars$_Baseline', 'Actual', '3930', 'wk05', 'D7']= N:
	If(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '5',
		-DB('84_Actuals_GL', !Org_Structure, '000315', !Versions, !t_Years, !t_Months, 'Dollars$')
		-DB('68_DailySales_GL_Std', !Org_Structure, !GL_Accounts, !Versions, !t_Years, !t_Months,'Total weeks', 'All_Days', 'Other_Income_Accrual'), CONTINUE);

['Dollars$_Baseline', 'Actual', '3930', 'wk04', 'D7']= N:
	If(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '4',
		-DB('84_Actuals_GL', !Org_Structure, '000315', !Versions, !t_Years, !t_Months, 'Dollars$')
		-DB('68_DailySales_GL_Std', !Org_Structure, !GL_Accounts, !Versions, !t_Years, !t_Months,'Total weeks', 'All_Days', 'Other_Income_Accrual'), CONTINUE);

#Bring Sales Discounts from 68_DailySales_GL_Std Last Day, Last Week minus Accrual
['Dollars$_Baseline', 'Actual', '6065G', 'wk05', 'D7']= N:
