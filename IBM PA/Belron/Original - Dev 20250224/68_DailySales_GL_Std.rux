		-DB('68_DailySales_GL_Std', !Org_Structure, !GL_Accounts, !Versions, !t_Years, !t_Months,'Total weeks', 'All_Days', 'Other_Income_Accrual'), CONTINUE);

['Dollars$_Baseline', 'Actual', '6065G', 'wk04', 'D7']= N:
