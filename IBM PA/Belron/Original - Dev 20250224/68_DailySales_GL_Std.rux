['Dollars$_to_Spread', {'wk01', 'wk02', 'wk03', 'wk04', 'wk05'}, {'D2', 'D3', 'D4', 'D5', 'D6', 'D7'},  {'Budget', 'Forecast', 'Budget_Final'}] =N: 0;
['Dollars$_to_Spread', {'wk02', 'wk03', 'wk04', 'wk05'}, 'D1', {'Budget', 'Forecast', 'Budget_Final'}] =N: 0;

