 	DB('60_DailySales_Stats_Std_Vanfax', ATTRS('Org_Structure_Leaf', !Org_Structure, 'Prov_Code'), !Versions,  !t_Years, !t_Months, !t_Weeks, !t_Days, 'Units_Std'),
