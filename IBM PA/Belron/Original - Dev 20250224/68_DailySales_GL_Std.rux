#GL External Sales, Prime
[{'3810U','3807','3808','3816','3815','3850','6065G','5027S','3811'}, 'Dollars$_Baseline', {'Budget', 'Forecast', 'Budget_Final'}]= N:
		DB('67_DailySales_Stats_Std', !Org_Structure, 'Externe', ATTRS('GL_Accounts_Leaf',!GL_accounts, 'Products'), !Versions, !t_Years, !t_Months, !t_Weeks, !t_Days, 'Sales$_Baseline')
		+DB('67_DailySales_Stats_Std', !Org_Structure, 'Retail', ATTRS('GL_Accounts_Leaf', !GL_Accounts, 'Products'), !Versions, !t_Years, !t_Months, !t_Weeks, !t_Days, 'Sales$_Baseline');

#GL Interco Sales, Prime VANFAX ONLY
[{'4120','4130','4131', '4116', '4170', '4699'}, 'Dollars$_Baseline',  {'Budget', 'Forecast', 'Budget_Final'}]= N:
		DB('67_DailySales_Stats_Std', !Org_Structure, 'Interne', ATTRS('GL_Accounts_Leaf',!GL_accounts, 'Products'), !Versions, !t_Years, !t_Months, !t_Weeks, !t_Days, 'Sales$');

#### And Second is STD Days prorate calculation base on STD Week with Holiday To respect proportional days by Week
['Dollars$_Baseline', {'Budget', 'Forecast', 'Budget_Final'}, 'wk01'] = N:
	['%_Dollars$'] * DB('68_DailySales_GL_Std', !Org_Structure, !GL_Accounts, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', 'Dollars$_to_Spread')
			 * (DB('68_DailySales_GL_Std', !Org_Structure, !GL_Accounts, !Versions, !t_Years, !t_Months, !t_Weeks, 'All_Days', 'Baseline_Std'));

['Dollars$_Baseline', {'Budget', 'Forecast', 'Budget_Final'}, 'wk02'] = N:
	['%_Dollars$'] * DB('68_DailySales_GL_Std', !Org_Structure, !GL_Accounts, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', 'Dollars$_to_Spread')
			 * (DB('68_DailySales_GL_Std', !Org_Structure, !GL_Accounts, !Versions, !t_Years, !t_Months, !t_Weeks, 'All_Days', 'Baseline_Std'));

['Dollars$_Baseline', {'Budget', 'Forecast', 'Budget_Final'}, 'wk03'] = N:
	['%_Dollars$'] * DB('68_DailySales_GL_Std', !Org_Structure, !GL_Accounts, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', 'Dollars$_to_Spread')
			 * (DB('68_DailySales_GL_Std', !Org_Structure, !GL_Accounts, !Versions, !t_Years, !t_Months, !t_Weeks, 'All_Days', 'Baseline_Std'));

['Dollars$_Baseline', {'Budget', 'Forecast', 'Budget_Final'}, 'wk04'] = N:
	['%_Dollars$'] * DB('68_DailySales_GL_Std', !Org_Structure, !GL_Accounts, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', 'Dollars$_to_Spread')
			 * (DB('68_DailySales_GL_Std', !Org_Structure, !GL_Accounts, !Versions, !t_Years, !t_Months, !t_Weeks, 'All_Days', 'Baseline_Std'));

['Dollars$_Baseline', {'Budget', 'Forecast', 'Budget_Final'}, 'wk05'] = N:
	['%_Dollars$'] * DB('68_DailySales_GL_Std', !Org_Structure, !GL_Accounts, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', 'Dollars$_to_Spread')
			 * (DB('68_DailySales_GL_Std', !Org_Structure, !GL_Accounts, !Versions, !t_Years, !t_Months, !t_Weeks, 'All_Days', 'Baseline_Std'));



