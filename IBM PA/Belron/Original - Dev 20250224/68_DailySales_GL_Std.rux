#Accrual Provision Royalty is base on Budget
#MR 27-11-2018 adding all GL
#['Dollars$_Baseline', 'Actual', '3930']= N:
#		DB('68_DailySales_GL_Std', !Org_Structure, '3930b', {'Budget', 'Forecast', 'Budget_Final'}, !t_Years, !t_Months, !t_Weeks, !t_Days, 'Dollars$');

['Dollars$_Baseline', 'Actual', '3930']= N:
		DB('68_DailySales_GL_Std', !Org_Structure, '3930b', 'Budget', !t_Years, !t_Months, !t_Weeks, !t_Days, 'Dollars$')
		+DB('68_DailySales_GL_Std', !Org_Structure, '3930m', 'Budget', !t_Years, !t_Months, !t_Weeks, !t_Days, 'Dollars$')
		+DB('68_DailySales_GL_Std', !Org_Structure, '3930a', 'Budget', !t_Years, !t_Months, !t_Weeks, !t_Days, 'Dollars$');


#Accrual Sales Discounts is base on provision 2% Retail and 11% Vanfax
#CSJ 2022-12-03 Modified for 2023 and after.
['Dollars$_Baseline', 'Actual', '6065G']= N:
    IF(!t_Years @>= '2023',
    	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH',
    	-DB('66_DailySales_GL', !Org_Structure, '000105', !Versions, !t_Years, !t_Months, !t_Weeks, !t_Days, 'Dollars$') * 0.01,
    	-DB('66_DailySales_GL', !Org_Structure, '000105', !Versions, !t_Years, !t_Months, !t_Weeks, !t_Days, 'Dollars$') * 0.06)
        , CONTINUE);


#CSJ 2021-02-14 Modified for 2021 and after.
['Dollars$_Baseline', 'Actual', '6065G']= N:
    IF(!t_Years @>= '2021',
    	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH',
    	-DB('66_DailySales_GL', !Org_Structure, '000105', !Versions, !t_Years, !t_Months, !t_Weeks, !t_Days, 'Dollars$') * 0.0015,
    	-DB('66_DailySales_GL', !Org_Structure, '000105', !Versions, !t_Years, !t_Months, !t_Weeks, !t_Days, 'Dollars$') * 0.0625)
        , CONTINUE);

#Mart 2015-05-06 request to modidy Wholesales Discounts from .11 to .10
['Dollars$_Baseline', 'Actual', '6065G']= N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH',
	-DB('66_DailySales_GL', !Org_Structure, '000105', !Versions, !t_Years, !t_Months, !t_Weeks, !t_Days, 'Dollars$') * .02,
	-DB('66_DailySales_GL', !Org_Structure, '000105', !Versions, !t_Years, !t_Months, !t_Weeks, !t_Days, 'Dollars$') * .10);



