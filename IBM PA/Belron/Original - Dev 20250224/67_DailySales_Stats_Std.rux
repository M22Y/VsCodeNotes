########################################################################
########################################################################


# Delete all years before 2019.
[{'2013', '2014', '2015', '2016', '2017', '2018' }] = N: 0;

##
##
## CSJ  2014-12-09  Changer feeders pour 1er jours / 1ere semaine
##

#Stet
['Actual', {'2010', '2011', '2012'}]= 0;
[{'Budget', 'Forecast', 'Budget_Final'}, {'2010', '2011', '2012', '2013'}]= 0;
[{'Forecast', 'Rolling_Fct_Adj', 'Rolling_Forecast'}, {'2010', '2011', '2012', '2013', '2014'}]= 0;


#[{'Units_Inc_Dec_Adj', 'Sales$_Inc_Dec_Adj'}, {'Budget', 'Forecast', 'Budget_Final'}] = N: 0;

#[{'Units_Inc_Dec_Adj', 'Sales$_Inc_Dec_Adj'}, {'Forecast', 'Rolling_Fct_Adj', 'Rolling_Forecast'}] = N:
#	IF (DB('97_Daily_Sales_Actual_Flags', !Versions, !t_Years, !t_Months, !t_Weeks, !t_Days) = 1, ['Actual'],0);



#Put at zero
#Only Prime
## CSJ: Commentaire pcq il ne devrait pas y avoir de chiffres ici.
#[] =N: IF(ATTRS('Products_Detailed', !Products_Detailed, 'isNonPrime') @= 'Y', STET, CONTINUE);
#
##CSJ Put zero here.
['Kits_Retail'] =N:
	IF(ATTRS('Org_Structure_Leaf', !Org_Structure, 'SB_Code') @= 'WH', 0, CONTINUE);

#
['wk05'] =N: IF(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '4', 0, CONTINUE);
#
['Discounts_Accrual', {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Deductibles', 'Kits_Retail', 'Repairs'}] =N: 0 ;
['Sales_Discounts', 'Actual', { 'Insurance', 'Cash', 'Fleet', 'Trade'},  'Sales$_Baseline'] =N: 0;


#Variation Version calculation
['Var%_Act-Bud'] = (['Actual'] - ['Budget']) \ ['Budget'];
['Var%_Act-Bud_Final'] = (['Actual'] - ['Budget_Final']) \ ['Budget_Final'];
['Var%_Act-Rolling_Fct'] = (['Actual'] - ['Rolling_Forecast']) \ ['Rolling_Forecast'];
['Var%_Rolling_Fct-Bud_Final'] = (['Rolling_Forecast'] - ['Budget_Final']) \ ['Budget_Final'];

['Var_Act-LY'] = ['Actual'] - DB('67_DailySales_Stats_Std', !Org_Structure, !Customer_Segments, !Products_Detailed, 'Actual', STR(NUMBR(!t_Years)-1,4,0), !t_Months, !t_Weeks, !t_Days, !m_ETL_Stats_Daily_Std);
['Var%_Act-LY'] = (['Actual'] - DB('67_DailySales_Stats_Std', !Org_Structure, !Customer_Segments, !Products_Detailed, 'Actual', STR(NUMBR(!t_Years)-1,4,0), !t_Months, !t_Weeks, !t_Days, !m_ETL_Stats_Daily_Std)) \ DB('67_DailySales_Stats_Std', !Org_Structu
re, !Customer_Segments, !Products_Detailed, 'Actual', STR(NUMBR(!t_Years)-1,4,0), !t_Months, !t_Weeks, !t_Days, !m_ETL_Stats_Daily_Std) ;

#################################
#LY Full Year not link to Flag
['Sales_Units_All_Year']= N: ['Units_Baseline'] + ['Units_Inc_Dec_Adj'];
['Sales$_Gross_All_Year', {'Sales_Discounts', 'Deductibles'}] = N: 0;
['Sales$_Gross_All_Year']= N: ['Sales$_Baseline'] + ['Sales$_Inc_Dec_Adj'];
###Gross Sales




######################################
#Flag to show Budget and LY data only if it has an actual data

[{'Sales_Units', 'Sales$'}, {'Actual', 'Budget', 'Forecast', 'Budget_Final'}] = N: IF (DB('97_Daily_Sales_Actual_Flags', !Versions, !t_Years, !t_Months, !t_Weeks, !t_Days) = 0,0, CONTINUE);


#Exclut Windsh units de Vanfax
['Repair Ratio', {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Kits_Retail', 'Sales_Discounts', 'Deductibles', 'Replacement', 'Total_Prime'}] = 0;
['Repair Ratio'] = IF(ATTRS('Org_Structure', !Org_Structure, 'SB_Code')@= 'WH', 0,
	 IF(['Sales_Units', 'Repairs']=0, 0, (['Sales_Units', 'Repairs']) \ (['Sales_Units', 'Repairs'] + ['Sales_Units', 'Windshield'])));

##############
##### Total accrual excluding the last day (D7) to allow to do a calculation at the last day of the last week
['Sales_Discounts', 'Actual', {'Insurance', 'APPLE_FR', 'LEBEAU_FR', 'DURO_FR',	'STD_FR',	'NOVUS_FR', 'ISP', 'Commercial_EXT', 'Other_EXT', 'Grossiste', 'No_Segment_EXT'}, 'wk05', 'D7', 'Discounts_Accrual'] =N:
	if(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '5', 0 ,CONTINUE);

['Sales_Discounts', 'Actual', {'Insurance',  'APPLE_FR', 'LEBEAU_FR', 'DURO_FR',	'STD_FR',	'NOVUS_FR', 'ISP', 'Commercial_EXT', 'Other_EXT', 'Grossiste', 'No_Segment_EXT'}, 'wk04', 'D7', 'Discounts_Accrual'] =N:
	if(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '4', 0 ,CONTINUE);

['Sales_Discounts', 'Actual', {'Insurance',  'APPLE_FR', 'LEBEAU_FR', 'DURO_FR',	'STD_FR',	'NOVUS_FR', 'ISP', 'Commercial_EXT', 'Other_EXT', 'Grossiste', 'No_Segment_EXT'}, 'Discounts_Accrual'] =N: ['Sales$'];

################################################
#Actual
#Bring the Discount & Deductibles from 68_DailySales_GL_Std Last Day, Last Week - Accrual
['Sales_Discounts', 'Actual', {'Insurance',  'APPLE_FR', 'LEBEAU_FR', 'DURO_FR',	'STD_FR',	'NOVUS_FR', 'ISP', 'Commercial_EXT', 'Other_EXT', 'Grossiste', 'No_Segment_EXT'}, 'Sales$', 'wk05', 'D7'] =N:
	If(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '5',
		DB('85_ETL_Stats', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Sales$')
		-DB('67_DailySales_Stats_Std', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', 'Discounts_Accrual'), CONTINUE);

['Sales_Discounts', 'Actual', {'Insurance',  'APPLE_FR', 'LEBEAU_FR', 'DURO_FR',	'STD_FR',	'NOVUS_FR', 'ISP', 'Commercial_EXT', 'Other_EXT', 'Grossiste', 'No_Segment_EXT'}, 'Sales$', 'wk04', 'D7'] =N:
	If(ATTRS('t_Months', !t_Months, 'Nb_Week') @= '4',
		DB('85_ETL_Stats', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Sales$')
		-DB('67_DailySales_Stats_Std', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', 'Discounts_Accrual'), CONTINUE);

##Modif Taux
#Provision Accrual 2% Retail and 10% Wholesales on Prime
['Sales_Discounts', 'Actual', 'No_Segment_EXT', 'Sales$'] =N:
	IF(ATTRS('Org_Structure_Leaf', !Org_Structure, 'SB_Code') @= 'WH',
		IF( !t_Years @>= '2023', ['Sales$_Gross', 'Total_Prime', 'Externe'] *-0.06,
			IF(!t_Years @>= '2021', ['Sales$_Gross', 'Total_Prime', 'Externe'] *-0.0625
									, ['Sales$_Gross', 'Total_Prime', 'Externe'] *-.10))
			, 0);

['Sales_Discounts', 'Actual', 'Insurance', 'Sales$'] =N:
    IF(!t_Years @>= '2023', ['Sales$_Gross', 'Total_Prime', 'Retail'] *-0.01
    	, IF(!t_Years @>= '2021', ['Sales$_Gross', 'Total_Prime', 'Retail'] *-0.0015
							, ['Sales$_Gross', 'Total_Prime', 'Retail'] *-.02));

##########################################################
#Actual from cube 65 Units_Baseline
['Units_Baseline', 'Actual'] =N:
		DB('65_DailySales_Stats', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, !t_Weeks, !t_Days, 'Sales_Units');
#
['Sales$_Baseline', 'Actual'] =N:
		DB('65_DailySales_Stats', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, !t_Weeks, !t_Days, 'Sales$');

#[{'Units_Baseline', 'Sales$_Baseline', 'Units_Inc_Dec_Adj', 'Sales$_Inc_Dec_Adj'}, {'Forecast', 'Rolling_Fct_Adj'}] =N:
