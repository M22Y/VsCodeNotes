FEEDERS;

['Sales_Units', 'Repairs']=>  ['Repair Ratio'];

['Units_Baseline'] => ['Sales_Units_All_Year'];
['Units_Inc_Dec_Adj']=> ['Sales_Units_All_Year'];
['Sales$_Baseline']=> ['Sales$_Gross_All_Year'];
['Sales$_Inc_Dec_Adj']=> ['Sales$_Gross_All_Year'];


['Sales$', {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Deductibles', 'Sales_Discounts', 'Kits_Retail', 'Repairs'}] => ['ASP'];
['Sales$', {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Kits_Retail', 'Repairs'}] => ['Sales$_Gross'];
['Sales$_Gross', {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Kits_Retail', 'Repairs'}] => ['ASP_Gross'];

['Sales_Discounts', 'Sales$', 'Actual']=>  ['Discounts_Accrual'];

['Actual']=> ['Var_Act-LY'];
['Actual']=> ['Var%_Act-LY'];

