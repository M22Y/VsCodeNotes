###Actual manual Adj (In case of AS400 file's is wrong and will be fix the day after)
['Sales_units'] =N: ['Units_Baseline'] + ['Units_Inc_Dec_Adj'];
['Sales$'] =N: ['Sales$_Baseline'] + ['Sales$_Inc_Dec_Adj'];

###########################################################
###Holiday from Cube 94
['Holiday',  {'Budget', 'Forecast', 'Budget_Final'}] =N:
	DB('94_Holiday', ATTRS('Org_Structure_Leaf', !Org_Structure, 'Prov_Code'),  !Versions, !t_Years, !t_Months, !t_Weeks, !t_Days, !m_ETL_Stats_Daily_Std);

