#[{'Units_Baseline', 'Sales$_Baseline', 'Units_Inc_Dec_Adj', 'Sales$_Inc_Dec_Adj'}, 'Budget_Final'] => ['Rolling_Forecast'];

['Sales$_Gross', 'Total_Prime', 'Externe', 'Actual']=> ['Sales_Discounts',  'No_Segment_EXT', 'Sales$'];
['Sales$_Gross', 'Total_Prime', 'Retail', 'Actual']=> ['Sales_Discounts',  'Insurance', 'Sales$'];


['Sales$_to_Spread', 'D1-Sat', 'wk01', {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Deductibles', 'Sales_Discounts', 'Kits_Retail', 'Repairs'}, {'Budget', 'Forecast', 'Budget_Final'}] =>
	DB('67_DailySales_Stats_Std', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', 'Sales$_Std'),
	DB('67_DailySales_Stats_Std', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', 'Sales$_Std_Adj'),
	DB('67_DailySales_Stats_Std', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', '%_Sales$'),
	DB('67_DailySales_Stats_Std', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', 'Sales$_Baseline'),
	DB('67_DailySales_Stats_Std', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', 'Sales$_Inc_Dec_Adj'),
	DB('67_DailySales_Stats_Std', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', 'Holiday');

['Units_to_Spread', 'D1-Sat', 'wk01', {'Windshield', 'Side', 'Back', 'RV_Glass', 'Bus_Glass', 'Deductibles', 'Sales_Discounts', 'Kits_Retail', 'Repairs'},  {'Budget', 'Forecast', 'Budget_Final'}] =>
	DB('67_DailySales_Stats_Std', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', 'Units_Std'),
	DB('67_DailySales_Stats_Std', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', 'Units_Std_Adj'),
	DB('67_DailySales_Stats_Std', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', '%_Units'),
	DB('67_DailySales_Stats_Std', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', 'Units_Baseline'),
	DB('67_DailySales_Stats_Std', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', 'Units_Inc_Dec_Adj'),
	DB('67_DailySales_Stats_Std', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', 'Holiday');

