['Sales$_Baseline', {'Budget', 'Forecast', 'Budget_Final'}, 'wk05'] = N:
	['%_Sales$'] * DB('67_DailySales_Stats_Std', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, 'Total weeks', 'All_Days', 'Sales$_to_Spread')
			 * (DB('67_DailySales_Stats_Std', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, !t_Weeks, 'All_Days', 'Sales$_Std'));


###Gross Sales
['Sales$_Gross', {'Sales_Discounts', 'Deductibles'}] = N: 0;
['Sales$_Gross'] = N: ['Sales$'];

####ASP
#['ASP', {'Sales_Discounts','Deductibles'},'Insurance']= N:IF(ATTRS('Org_Structure_Leaf', !Org_Structure, 'SB_Code') @= 'WH', 0,
#	IF(['Sales_Units', 'Replacement']=0, ['Sales$'], ['Sales$']\['Sales_Units', 'Replacement']));
#
#['ASP', {'Sales_Discounts','Deductibles'},{'Interne','APPLE_FR','LEBEAU_FR','DURO_FR','STD_FR','NOVUS_FR','ISP','Commercial_EXT','Other_EXT','Grossiste','No_Segment_EXT'}]= N:
#	IF(ATTRS('Org_Structure_Leaf', !Org_Structure, 'SB_Code') @= 'WH',
#		IF(['Sales_Units', 'Replacement']=0,['Sales$'],['Sales$']\['Sales_Units', 'Replacement']),
#		0);

['ASP', {'Sales_Discounts','Deductibles', 'Kits_Retail'}] = N: IF(['Sales_Units', 'Replacement']=0, ['Sales$'], ['Sales$']\['Sales_Units', 'Replacement']);
#['ASP', 'Kits_Retail']= N: IF(['Sales_Units']=0, ['Sales$'],['Sales$']\['Sales_Units', 'Replacement']);
['ASP']=  IF(['Sales_Units']=0, ['Sales$'], ['Sales$']\ ['Sales_Units']);
#['ASP']= C: IF(['Sales_Units']=0, ['Sales$'], ['Sales$']\ ['Sales_Units']);
###
['ASP_Gross', {'Sales_Discounts','Deductibles'},'Insurance']= N:IF(ATTRS('Org_Structure_Leaf', !Org_Structure, 'SB_Code') @= 'WH', 0,
	IF(['Sales_Units', 'Replacement']=0, ['Sales$_Gross'], ['Sales$_Gross']\['Sales_Units', 'Replacement']));

['ASP_Gross', {'Sales_Discounts','Deductibles'},{'Interne','APPLE_FR','LEBEAU_FR','DURO_FR','STD_FR','NOVUS_FR','ISP','Commercial_EXT','Other_EXT','Grossiste','No_Segment_EXT'}]= N:
	IF(ATTRS('Org_Structure_Leaf', !Org_Structure, 'SB_Code') @= 'WH',
		IF(['Sales_Units', 'Replacement']=0,['Sales$_Gross'],['Sales$_Gross']\['Sales_Units', 'Replacement']),
		0);

['ASP_Gross', {'Sales_Discounts','Deductibles'}] = N: IF(['Sales_Units', 'Replacement']=0, ['Sales$_Gross'], ['Sales$_Gross']\['Sales_Units', 'Replacement']);
['ASP_Gross', 'Kits_Retail']= N: IF(['Sales_Units', 'Replacement']=0, ['Sales$_Gross'],['Sales$_Gross']\['Sales_Units', 'Replacement']);
['ASP_Gross']= N: IF(['Sales_Units']=0, ['Sales$_Gross'], ['Sales$_Gross']\ ['Sales_Units']);
['ASP_Gross']= C: IF(['Sales_Units']=0, ['Sales$_Gross'], ['Sales$_Gross']\ ['Sales_Units']);


####AVG CONSO
['Holiday'] = C: ConsolidatedAvg(2, '', !Org_Structure, !Customer_Segments, !Products_Detailed, !Versions, !t_Years, !t_Months, !t_Weeks, !t_Days, !m_ETL_Stats_Daily_Std);
