SKIPCHECK;
FEEDSTRINGS;

#########3
## Rules will be fed by 10, 11 (Prime and non prime) and by 30 (needed related stuff).
##
##
############################################################################################

[{'2009', '2010', '2011', '2012'}]= N: STET;
['Actual']= N: ['Budget'];



##
## 2014-05-29  CSJ  Creation.

['OVT_Rate', {'Actual', 'Forecast', 'Budget', 'Rolling_Fct_Adj'}] =  DB('31_Manning_Assump_Global', !Versions, !t_Years, !m_Manning_Assump);
['Std_Hrs_Replacement_per_Unit', {'Actual','Forecast', 'Budget', 'Rolling_Fct_Adj'}] =  DB('31_Manning_Assump_Global', !Versions, !t_Years, !m_Manning_Assump);
#['Std_Hrs_Replac_Prepar_per_Unit', {'Actual','Forecast', 'Budget', 'Rolling_Fct_Adj'}] =  DB('31_Manning_Assump_Global', !Versions, !t_Years, !m_Manning_Assump);
#['Std_Hrs_Replac_Bought_per_Unit', {'Actual','Forecast', 'Budget', 'Rolling_Fct_Adj'}] =  DB('31_Manning_Assump_Global', !Versions, !t_Years, !m_Manning_Assump);
['Std_Hrs_Repair_per_Unit', {'Actual','Forecast', 'Budget', 'Rolling_Fct_Adj'}] =  DB('31_Manning_Assump_Global', !Versions, !t_Years, !m_Manning_Assump);
#['Std_Hrs_Repair_Prepar_per_Unit', {'Actual','Forecast', 'Budget', 'Rolling_Fct_Adj'}] =  DB('31_Manning_Assump_Global', !Versions, !t_Years, !m_Manning_Assump);
