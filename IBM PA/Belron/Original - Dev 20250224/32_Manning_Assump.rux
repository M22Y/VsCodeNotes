FEEDERS;

['Budget']=> ['Actual'];

['Total_$_Flat_Glass_per_Std_Hrs', {'Actual', 'Budget', 'Forecast', 'Rolling_Fct_Adj'}] => DB('34_Manning_Time_Needed', !Org_Structure, !Versions, !t_Years, 'Total_Months', '$_Flat_Glass_per_Std_Hrs');
['Total_$_Alcometer_per_Std_Hrs', {'Actual', 'Budget', 'Forecast', 'Rolling_Fct_Adj'}] => DB('34_Manning_Time_Needed', !Org_Structure, !Versions, !t_Years, 'Total_Months', '$_Alcometer_per_Std_Hrs');
['Total_$_Other_Sales_per_Std_Hrs', {'Actual', 'Budget', 'Forecast', 'Rolling_Fct_Adj'}] => DB('34_Manning_Time_Needed', !Org_Structure, !Versions, !t_Years, 'Total_Months', '$_Other_Sales_per_Std_Hrs');

