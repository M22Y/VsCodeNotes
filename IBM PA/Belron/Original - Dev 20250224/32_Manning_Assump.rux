['$_Flat_Glass_per_Std_Hrs', {'Actual','Forecast', 'Budget', 'Rolling_Fct_Adj'}] =  DB('31_Manning_Assump_Global', !Versions, !t_Years, !m_Manning_Assump);
['$_Alcometer_per_Std_Hrs', {'Actual','Forecast', 'Budget', 'Rolling_Fct_Adj'}] =  DB('31_Manning_Assump_Global', !Versions, !t_Years, !m_Manning_Assump);
['$_Other_Sales_per_Std_Hrs', {'Actual','Forecast', 'Budget', 'Rolling_Fct_Adj'}] =  DB('31_Manning_Assump_Global', !Versions, !t_Years, !m_Manning_Assump);
['Manager_Indirect_Efficiency%', {'Actual','Forecast', 'Budget', 'Rolling_Fct_Adj'}]  = N: DB('31_Manning_Efficiency_Indirect', !Versions, !t_Years,
	IF(ROUND(DB('33_Manning_Time_Available', !Org_Structure, 'Total', 'TECHNICIAN', !Versions, !t_Years, 'Total_Months', 'Head_Count'))< DB('33_Manning_Time_Available', !Org_Structure, 'Total', 'TECHNICIAN', !Versions, !t_Years, 'Total_Months', 'Head_Count')
,
		STR(ROUND(DB('33_Manning_Time_Available', !Org_Structure, 'Total', 'TECHNICIAN', !Versions, !t_Years, 'Total_Months', 'Head_Count')) + 1, 2, 0),
		STR(DB('33_Manning_Time_Available', !Org_Structure, 'Total', 'TECHNICIAN', !Versions, !t_Years, 'Total_Months', 'Head_Count'), 2, 0)), !m_Manning_Assump);

['CSR_Indirect_Efficiency%', {'Actual', 'Forecast', 'Budget', 'Rolling_Fct_Adj'} ]   = N: DB('31_Manning_Efficiency_Indirect', !Versions, !t_Years,
	IF(ROUND(DB('33_Manning_Time_Available', !Org_Structure, 'Total', 'TECHNICIAN', !Versions, !t_Years, 'Total_Months', 'Head_Count'))< DB('33_Manning_Time_Available', !Org_Structure, 'Total', 'TECHNICIAN', !Versions, !t_Years, 'Total_Months', 'Head_Count')
,
		STR(ROUND(DB('33_Manning_Time_Available', !Org_Structure, 'Total', 'TECHNICIAN', !Versions, !t_Years, 'Total_Months', 'Head_Count')) + 1, 2, 0),
		STR(DB('33_Manning_Time_Available', !Org_Structure, 'Total', 'TECHNICIAN', !Versions, !t_Years, 'Total_Months', 'Head_Count'), 2, 0)), !m_Manning_Assump);

#['Manager_Efficiency%'] = N: DB('31_Manning_Assump_Global', !Versions, !t_Years, !m_Manning_Assump);
#['CSR_Efficiency%'] = N: DB('31_Manning_Assump_Global', !Versions, !t_Years, !m_Manning_Assump);
['OVT_Convert%', {'Actual','Forecast', 'Budget', 'Rolling_Fct_Adj'}] =  DB('31_Manning_Assump_Global', !Versions, !t_Years, !m_Manning_Assump);


#Avg
[{'Std_Hrs_Replacement_per_Unit', 'Std_Hrs_Replac_Prepar_per_Unit', 'Std_Hrs_Replac_Bought_per_Unit', 'Std_Hrs_Repair_per_Unit', 'Std_Hrs_Replac_Mobile_per_Unit', 'Std_Hrs_Repair_per_Unit', 'Std_Hrs_Repair_Prepar_per_Unit', 'Std_Hrs_Repair_Bought_per_Unit
