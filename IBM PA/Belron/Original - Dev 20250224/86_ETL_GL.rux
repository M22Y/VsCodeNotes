#AJUSTER L'ATTRIBUT BS VERSUS P&L using ATTRS('GL_Accounts_Leaf', !GL_Accounts, 'Type')

#2014-04-07 CSJ
#Mart 09/10/13:Test avec Load par TI
['Actual', 'Dollars$']=N:
		DB('84_Actuals_GL', !Org_Structure, !GL_Accounts, !Versions, !t_Years, !t_Months, !m_ETL_GL);
#Martfix : replace GL_Line by GL from the Attributes of GL_Line 'Child'
#Mart 24/10/13: Flag 1 Forecast feed from 84
[{'Forecast', 'Rolling_Fct_Adj'}, 'Dollars$']=N:
		IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
		DB('86_ETL_GL', !Org_Structure, !GL_Accounts, 'Actual', !t_Years, !t_Months, !m_ETL_GL), CONTINUE);

#Mart 04-11-2013 Upload Budget 2013 from Cognos Planning to TM1
#Mart 27-02-2014 trsf Budget 2013 by TI
['Budget', '2013', 'Dollars$']= N: IF( !GL_Accounts @= ATTRS('GL_Accounts_Line', ELPAR('GL_Accounts', !GL_Accounts, 1), 'Child'),
	DB('20_OtherGL', !Org_Structure, ELPAR('GL_Accounts', !GL_Accounts, 1) , !Versions, !t_Years, !t_Months, 'Adjusted_Total'),0);


