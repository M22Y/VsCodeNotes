#region Capex depuis Cube 56
[{'5029',  '5029A',  '5029B',  '5029C',  '5029E', '5029F', '5029I', '5029L', '5029P', '5029R', '5029S',  '5029T', '5029V', '9014', '9014E', '9014F', '9014I', '9014L', '9014P', '9014R', '9014S', '9014V'}, {'Forecast', 'Rolling_Fct_Adj'}, 'Dollars$']= N:
	IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
	['Actual', 'Dollars$'],
	DB('56_Capex_Dep', !Org_Structure, !GL_accounts, !Versions, !t_Months |'-' | SUBST(!t_Years,3,2), 'Total_Depreciation'));

[{'5029',  '5029A',  '5029B',  '5029C',  '5029E', '5029F', '5029I', '5029L', '5029P', '5029R', '5029S',  '5029T', '5029V', '9014', '9014E', '9014F', '9014I', '9014L', '9014P', '9014R', '9014S', '9014V'}, 'Budget', 'Dollars$']= N:
	DB('56_Capex_Dep', !Org_Structure,  !GL_accounts, !Versions, !t_Months |'-' | SUBST(!t_Years,3,2), 'Total_Depreciation');
#endregion

[{'Forecast', 'Budget', 'Rolling_Fct_Adj'}, 'Dollars$']= N: IF( !GL_Accounts @= ATTRS('GL_Accounts_Line', ELPAR('GL_Accounts', !GL_Accounts, 1), 'Child'),
	DB('20_OtherGL', !Org_Structure, ELPAR('GL_Accounts', !GL_Accounts, 1) , !Versions, !t_Years, !t_Months, 'Adjusted_Total'),0);

