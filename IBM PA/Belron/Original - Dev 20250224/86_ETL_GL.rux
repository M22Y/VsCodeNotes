#Mart 2014-04-14 Put at zero years without reference Start new process date
['Forecast', t_years:{'2009', '2010','2011','2012'}] =N: 0;
['Budget', t_years:{'2009', '2010','2011','2012'}] =N: 0;

#Stet Budget and Forecast Version previous year (copy from Budget Final and Forecast Final)
[{'Budget', 'Forecast'}, {'2013', '2014'}]= STET;
#Put at zero previous year
