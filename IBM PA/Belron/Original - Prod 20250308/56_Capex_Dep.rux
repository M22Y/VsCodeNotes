['Adjustement', {'5029L', '9014L'}, {'Forecast', 'Budget','Rolling_Fct_Adj'}] => DB('56_Capex_Dep', !Org_Structure, '0862B', !Versions, !t_Months_Continuous, 'Adjustement_CumulAmort');
['Adjustement', {'5029P', '9014P'}, {'Forecast', 'Budget','Rolling_Fct_Adj'}] => DB('56_Capex_Dep', !Org_Structure, '0840B', !Versions, !t_Months_Continuous, 'Adjustement_CumulAmort');
['Adjustement', {'5029R', '9014R'}, {'Forecast', 'Budget','Rolling_Fct_Adj'}] => DB('56_Capex_Dep', !Org_Structure, '0861B', !Versions, !t_Months_Continuous, 'Adjustement_CumulAmort');
['Adjustement', '5029S', {'Forecast', 'Budget','Rolling_Fct_Adj'}] => DB('56_Capex_Dep', !Org_Structure, '0807B', !Versions, !t_Months_Continuous, 'Adjustement_CumulAmort');
['Adjustement', {'5029V', '9014V'}, {'Forecast', 'Budget','Rolling_Fct_Adj'}] => DB('56_Capex_Dep', !Org_Structure, '0870B', !Versions, !t_Months_Continuous, 'Adjustement_CumulAmort');

#Mart 2014-06-13 trsf directly to cube 86
#Mart 10-24-13 ajout depreciation dans le cube 20
['Total_Depreciation', {'Forecast', 'Budget','Rolling_Fct_Adj'}] =>
	DB('20_OtherGL', !Org_Structure, ELPAR('GL_Accounts', !GL_Accounts_Depreciation, 1), !Versions,
		'20' | SUBST(!t_Months_Continuous, 5, 2),
		SUBST(!t_Months_Continuous, 1, 3),
		'Baseline');

['Total_Depreciation', {'Forecast', 'Budget','Rolling_Fct_Adj'}] =>
	DB('86_ETL_GL', !Org_Structure, !GL_Accounts_Depreciation, !Versions,
		'20' | SUBST(!t_Months_Continuous, 5, 2),
		SUBST(!t_Months_Continuous, 1, 3),
		'Dollars$');

['Total_CumAmort', 'CY', {'Forecast', 'Budget','Rolling_Fct_Adj'}] => DB('51_BS_Manual', '120000', !Versions,!t_Months_Continuous, 'Inc_Dec$');


