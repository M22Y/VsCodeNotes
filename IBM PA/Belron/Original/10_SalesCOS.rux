    DB(IF(!t_Years @<> '2021', '08_SalesCOS_Assump_by_Customer_Insur', ''),!Org_Structure,'ADM000001',!Customer_Segments,!Products_Detailed,!Versions,!t_Years,!t_Months,'Units_Baseline');



