			DB('13_Internal_Transfer',  !Org_Structure, !Products_Detailed, !Customer_Segments,  !Versions, !t_Years, !t_Months, 'Total_Units'), CONTINUE));

 ['Units_Baseline', 'Forecast', 'Windshield']= N:
	 IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
	 ['Actual', 'Replacement', 'Total_Units'],
	  DB('10_SalesCOS', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Actual', STR(NUMBR(!t_Years)-1,4,0), !t_Months, 'Total_Units'));

 ['Units_Baseline', 'Forecast', 'Repairs']= N:
	 IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
	 ['Actual', 'Total_Units'],
		IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH',
			DB('10_SalesCOS', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Actual', STR(NUMBR(!t_Years)-1,4,0), !t_Months, 'Total_Units'), CONTINUE));


#29-09-2014 Baseline Rolling_Fct_Adj First Year Baseline = Bud 2015
 ['Units_Baseline', 'Rolling_Fct_Adj', '2015', 'Interne', 'Windshield']= N:
	 IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
	 ['Actual', 'Replacement', 'Total_Units'],
		IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @= 'WH',
			DB('13_Internal_Transfer',  !Org_Structure, !Products_Detailed, !Customer_Segments,  !Versions, !t_Years, !t_Months, 'Total_Units'), CONTINUE));

 ['Units_Baseline', 'Rolling_Fct_Adj', '2015', 'Windshield']= N:
	 IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
	 ['Actual', 'Replacement', 'Total_Units'],
	  DB('10_SalesCOS', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Actual', '2014', !t_Months, 'Total_Units'));

 ['Units_Baseline', 'Rolling_Fct_Adj', '2015', 'Repairs']= N:
	 IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
	 ['Actual', 'Total_Units'],
	  DB('10_SalesCOS', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Actual', '2014', !t_Months, 'Total_Units'));

#29-09-2014 Baseline Rolling_Fct_Adj Baseline = Rolling_Fct_Adj N-1
 ['Units_Baseline', 'Rolling_Fct_Adj', 'Interne', 'Windshield']= N:
	 IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
	 ['Actual', 'Replacement', 'Total_Units'],
		IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @= 'WH',
			DB('13_Internal_Transfer',  !Org_Structure, !Products_Detailed, !Customer_Segments, !Versions, !t_Years, !t_Months, 'Total_Units'), CONTINUE));

 ['Units_Baseline', 'Rolling_Fct_Adj', 'Windshield']= N:
	 IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
	 ['Actual', 'Replacement', 'Total_Units'],
	 DB('10_SalesCOS', !Org_Structure, !Products_Detailed, !Customer_Segments, !Versions, STR(NUMBR(!t_Years)-1,4,0), !t_Months, 'Total_Units'));

 ['Units_Baseline', 'Rolling_Fct_Adj', 'Repairs']= N:
	 IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
	 ['Actual', 'Total_Units'],
