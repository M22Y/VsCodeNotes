#Put Actual at 0
['Actual', {'Economic%', 'Economic_Units', 'Advertising%', 'Advertising_Units', 'Weather%', 'Weather_Units', 'Reinspection_Other%', 'Reinspection_Other_Units', 'Adjustment_Days%', 'Adjustment_Days_Units',
 'Titanium%', 'Titanium_Units',  'Other_Adj_Mkgt%', 'Other_Adj_Mkgt_Units', 'Other_Adj_Fin%', 'Other_Adj_Fin_Units',  'B2B_Load', 'Inc_Dec_Units', 'Conversion_Units', 'Conversion2_Units',  'Conversion3_Units',
 'Conversion4_Units', 'Conversion5_Units', 'Conversion6_Units',  'Trsf_units', 'DW_Units', 'Close_Store', 'Other_Adj_Units', 'Titanium_Adj_Units', 'Cust_Ins_Adj_Units',
 'Price_Impact%',  'Price_Impact$',  'Deductible_Wave%', 'Deductible_Wave$', 'Product_Mix%', 'Product_Mix$', 'Cash_Pricing%', 'Cash_Pricing$', 'Titanium_Impact%', 'Titanium$', 'ASP_Other%', 'ASP_Other$', 'Sales_Inc_Dec$',
 'Sales_Inc_Dec%',  'Sales_Inc_Dec%_Impact$', 'Glass_Related_Sales$',  'Inventory_Revaluation$', 'AAC_Inc_Dec$', 'AAC_Inc_Dec%', 'GM%_Revised', 'Glass_Related_Sales%', 'Glass_Related_Units_Adjusted',
 'Sales$_AIP',  'Sales$_Price_Impact$', 'Sales$_Deductible_Wave$', 'Sales$_Product_Mix$', 'Sales$_Cash_Pricing$',  'Sales$_ASP_Other$', 'Unrealized_Profit_on_Trans$', 'AAC_STD_Inc_Dec$', 'AAC_STD_Inc_Dec%',
 'Unrealized_Profit_Trans_Units', 'AAC_FX%', 'AAC_Mix%', 'AAC_RFP%', 'AAC_FX$', 'AAC_Mix$', 'AAC_RFP$',  'AAC_STD_FX%', 'AAC_STD_Mix%', 'AAC_STD_RFP%', 'AAC_STD_FX$', 'AAC_STD_Mix$', 'AAC_STD_RFP$'}]= 0;

#Forecast and Budget at the Replacement level (keep only Windshield & Sales Discount all the rest must be at 0)
[{'Side', 'Back', 'RV_Glass', 'Bus_Glass'}] = N: 0;

#Retail 100% in Winshield and Kit_Retail
[{'Sales_Discounts', 'Deductibles'}] = N:
		IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH', 0, CONTINUE);



#Put Actual at 0 100% cost is in No Segment and No Segment Ext
['Actual', {'BuyOut$', 'Exchange_Rate$_Impact', 'PPV$', 'Breakage$'}, {'Insurance', 'Cash', 'Trade', 'Fleet', 'Interne', 'APPLE_FR', 'LEBEAU_FR', 'DURO_FR', 'STD_FR', 'NOVUS_FR', 'ISP',
 'Commercial_EXT', 'Other_EXT', 'Grossiste'}]= 0;

#Put  Fct at 0 100% cost is in No Segment and No Segment Ext
[{'Forecast', 'Rolling_Fct_Adj'}, {'BuyOut$', 'Exchange_Rate$_Impact', 'PPV$', 'Breakage$'}, {'Insurance', 'Cash', 'Trade', 'Fleet', 'Interne', 'APPLE_FR', 'LEBEAU_FR', 'DURO_FR', 'STD_FR', 'NOVUS_FR', 'ISP',
 'Commercial_EXT', 'Other_EXT', 'Grossiste'}]= N:
	IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1, 0, CONTINUE);



[{'Deductibles'},
{'Inc_Dec_Units', 'Conversion_Units', 'Trsf_units', 'AIP_Baseline', 'Price_Impact%', 'Deductible_Wave%', 'Product_Mix%', 'ASP_Other$', 'Sales_Inc_Dec$', 'Sales_Inc_Dec%',
 'AAC_Inc_Dec$', 'AAC_Inc_Dec%', 'BuyOut_Units', 'Inventory_Revaluation_Units', 'Exchange_Rate_Units', 'PPV_Units', 'Breakage_Units', 'BuyOut$', 'Inventory_Revaluation$',
 'Exchange_Rate$_Impact', 'Unrealized_Profit_on_Trans$', 'PPV$', 'Breakage$', 'Prime_Units_Glass_Related_Consumer', 'Replacement_Units_Glass_Related'}]= 0;

['Kits_Retail',
{'Inc_Dec_Units', 'Conversion_Units', 'Trsf_units', 'AIP_Baseline', 'Price_Impact%', 'Deductible_Wave%', 'Product_Mix%', 'ASP_Other$', 'Sales_Inc_Dec$', 'Sales_Inc_Dec%', 'Inventory_Revaluation_Units',
 'Exchange_Rate_Units', 'PPV_Units', 'Inventory_Revaluation$', 'Exchange_Rate$_Impact', 'PPV$', 'Prime_Units_Glass_Related_Consumer', 'Replacement_Units_Glass_Related'}]= 0;

[{'Windshield', 'Repairs'}, {'Prime_Units_Glass_Related_Consumer', 'Replacement_Units_Glass_Related'}]= 0;


['Repairs', {'Forecast', 'Budget', 'Rolling_Fct_Adj'}]= N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @= 'WH', 0, CONTINUE);


['Market'] = N: 0;

############# Set Budget 2013 baseline at 0 ######################
############# all data to initialise is done in inc/dec ##########
['Budget', '2013', {'Units_Baseline','AIP_Baseline','Sales_Baseline','Material_Cost_Baseline'}] =0;

#To put at 0 Forecast month with Flag 1
[{'Forecast', 'Rolling_Fct_Adj'},  {'Economic%', 'Economic_Units', 'Advertising%', 'Advertising_Units', 'Weather%', 'Weather_Units', 'Reinspection_Other%', 'Reinspection_Other_Units', 'Adjustment_Days%', 'Adjustment_Days_Units',
 'Titanium%', 'Titanium_Units',  'Other_Adj_Mkgt%', 'Other_Adj_Mkgt_Units', 'Other_Adj_Fin%', 'Other_Adj_Fin_Units',  'B2B_Load', 'Inc_Dec_Units', 'Conversion_Units', 'Conversion2_Units',  'Conversion3_Units',
 'Conversion4_Units', 'Conversion5_Units', 'Conversion6_Units',  'Trsf_units', 'DW_Units', 'Close_Store', 'Other_Adj_Units', 'Titanium_Adj_Units', 'Cust_Ins_Adj_Units',
 'Price_Impact%',  'Price_Impact$',  'Deductible_Wave%', 'Deductible_Wave$', 'Product_Mix%', 'Product_Mix$', 'Cash_Pricing%', 'Cash_Pricing$', 'Titanium_Impact%', 'Titanium$', 'ASP_Other%', 'ASP_Other$', 'Sales_Inc_Dec$',
 'Sales_Inc_Dec%',  'Sales_Inc_Dec%_Impact$', 'Glass_Related_Sales$',  'Inventory_Revaluation$', 'AAC_Inc_Dec$', 'AAC_Inc_Dec%', 'GM%_Revised', 'Glass_Related_Sales%', 'Glass_Related_Units_Adjusted',
 'Sales$_AIP',  'Sales$_Price_Impact$', 'Sales$_Deductible_Wave$', 'Sales$_Product_Mix$', 'Sales$_Cash_Pricing$',  'Sales$_ASP_Other$', 'Unrealized_Profit_on_Trans$', 'AAC_STD_Inc_Dec$', 'AAC_STD_Inc_Dec%',
 'Unrealized_Profit_Trans_Units', 'AAC_FX%', 'AAC_Mix%', 'AAC_RFP%', 'AAC_FX$', 'AAC_Mix$', 'AAC_RFP$',  'AAC_STD_FX%', 'AAC_STD_Mix%', 'AAC_STD_RFP%', 'AAC_STD_FX$', 'AAC_STD_Mix$', 'AAC_STD_RFP$'} ]= N:
