            DB( '08_SalesCOS_B2B_WH_by_Customer',!Org_Structure, 'Total_Customer_Fleet_Wholesale', !Customer_Segments, !Products_Detailed,!Versions,!t_Years,!t_Months, 'Net_Sales');


