#############AAC################

#COS$ calculation
#New Mart 2015-19-05
['COS$_Pure', 'Kits_Retail'] =N: ['AAC_Pure']* IF(['Total_Units', 'Retail', 'Replacement']=0, 1,  ['Total_Units', 'Replacement', 'Retail']);
['COS$_Pure', 'No_Segment'] =N: ['AAC_Pure']* IF(['Total_Units', 'Retail']=0, 1, ['Total_Units', 'Retail']);
['COS$_Pure', 'No_Segment_EXT'] =N: ['AAC_Pure']* IF(['Total_Units', 'Externe']=0, 1, ['Total_Units', 'Externe']);
['COS$_Pure', 'Interne'] =N: ['AAC_Pure']* IF(['Total_Units', 'Interne']=0, 1, ['Total_Units', 'Interne']);
['COS$_Pure'] =N: ['AAC_Pure']* IF(['Total_Units']=0, 1, ['Total_Units']);

#New Mart 2015-03-08
['AAC_Inc_Dec%_Impact$']=N: ['AAC_Inc_Dec%']* ['Material_Cost_Baseline'];
['AAC_FX%_Impact$']=N: ['AAC_FX%']* ['Material_Cost_Baseline'];
['AAC_Mix%_Impact$']=N: ['AAC_Mix%']* ['Material_Cost_Baseline'];
['AAC_RFP%_Impact$']=N: ['AAC_RFP%']* ['Material_Cost_Baseline'];

#Mart 2015-06-15
#['AAC_FX$']=N: ['AAC_FX%']* ['Material_Cost_Baseline'];
#['AAC_Mix$']=N: ['AAC_Mix%']* ['Material_Cost_Baseline'];
#['AAC_RFP$']=N: ['AAC_RFP%']* ['Material_Cost_Baseline'];

#AAC unitaire lorsque pas de units
['AAC', 'Kits_Retail'] =C: IF(['Total_Units', 'Replacement', 'Retail']=0, ['COS$'], ['COS$']\['Total_Units', 'Replacement', 'Retail']);
['AAC', 'No_Segment']= C: IF(['Total_Units', 'Retail']=0, ['COS$'],['COS$']\['Total_Units', 'Retail']);
['AAC', 'No_Segment_EXT']= C: IF(['Total_Units', 'Externe']=0, ['COS$'],['COS$']\['Total_Units', 'Externe']);
['AAC', 'Interne']= C: IF(['Total_Units', 'Interne']=0, ['COS$'],['COS$']\['Total_Units', 'Interne']);
['AAC']= C: IF(['Total_Units']=0, ['COS$'],['COS$']\['Total_Units']);

#Mart 9-22-2014 AAC_Pure unitaire lorsque pas de units (trsf danbs le cube 13)
['AAC_Pure_Calc', 'Kits_Retail'] =  IF(['Total_Units', 'Replacement', 'Retail']=0, ['COS$_Pure'], ['COS$_Pure']\['Total_Units', 'Replacement', 'Retail']);
['AAC_Pure_Calc', 'No_Segment']=  IF(['Total_Units', 'Retail']=0, ['COS$_Pure'],['COS$_Pure']\['Total_Units', 'Retail']);
['AAC_Pure_Calc', 'No_Segment_EXT']=  IF(['Total_Units', 'Externe']=0, ['COS$_Pure'],['COS$_Pure']\['Total_Units', 'Externe']);
['AAC_Pure_Calc', 'Interne']=  IF(['Total_Units', 'Interne']=0, ['COS$_Pure'],['COS$_Pure']\['Total_Units', 'Interne']);
['AAC_Pure_Calc']=  IF(['Total_Units']=0, ['COS$_Pure'],['COS$_Pure']\['Total_Units']);

#Weighted average for total months
#['AAC_Inc_Dec%', 'Total_Months']= (['AAC_Inc_Dec%_Impact$']+['AAC_Inc_Dec$'])\['Material_Cost_Baseline'];
#['AAC_Inc_Dec%']= C: (['AAC_Inc_Dec%_Impact$']+['AAC_Inc_Dec$'])\['Units_Baseline'];
#Mart 2015-06-15
['AAC_Inc_Dec%', 'Total_Months']= (['AAC_Inc_Dec%_Impact$'] \ ['Material_Cost_Baseline']);
['AAC_Inc_Dec%']= C: (['AAC_Inc_Dec%_Impact$'] \ ['Material_Cost_Baseline']);
['AAC_FX%', 'Total_Months']= (['AAC_FX$'] \ ['Material_Cost_Baseline']);
['AAC_FX%']= C:(['AAC_FX$'] \ ['Material_Cost_Baseline']);
['AAC_Mix%', 'Total_Months']= (['AAC_Mix$'] \ ['Material_Cost_Baseline']);
['AAC_Mix%']= C:(['AAC_Mix$'] \ ['Material_Cost_Baseline']);
['AAC_RFP%', 'Total_Months']= (['AAC_RFP$'] \ ['Material_Cost_Baseline']);
['AAC_RFP%']= C:(['AAC_RFP$'] \ ['Material_Cost_Baseline']);

#############AAC_STD################
#MART 2015-05-08 New AAC STD
#COS_STD$ calculation
['COS$_STD_Pure', 'No_Segment', 'Repairs'] =N: ['AAC_STD_Pure']* IF(['Total_Units', 'Retail']=0, 1, ['Total_Units', 'Retail']);
['COS$_STD_Pure', 'No_Segment'] =N: ['AAC_STD_Pure']* IF(['Total_Units', 'Replacement', 'Retail']=0, 1,  ['Total_Units', 'Replacement', 'Retail']);
['COS$_STD_Pure', 'Kits_Retail'] =N: ['AAC_STD_Pure']* IF(['Total_Units', 'Replacement']=0, 1,  ['Total_Units', 'Replacement']);
['COS$_STD_Pure', 'No_Segment_EXT'] =N: ['AAC_STD_Pure']* IF(['Total_Units', 'Externe']=0, 1, ['Total_Units', 'Externe']);
['COS$_STD_Pure'] =N: ['AAC_STD_Pure']* IF(['Total_Units']=0, 1, ['Total_Units']);

['AAC_STD_Inc_Dec%_Impact$']=N: ['AAC_STD_Inc_Dec%']* ['Material_Cost_Baseline_STD'];
['AAC_STD_FX%_Impact$']=N: ['AAC_STD_FX%']* ['Material_Cost_Baseline_STD'];
['AAC_STD_Mix%_Impact$']=N: ['AAC_STD_Mix%']* ['Material_Cost_Baseline_STD'];
['AAC_STD_RFP%_Impact$']=N: ['AAC_STD_RFP%']* ['Material_Cost_Baseline_STD'];

#Mart 2015-06-15
#['AAC_STD_FX$']=N: ['AAC_STD_FX%']* ['Material_Cost_Baseline_STD'];
#['AAC_STD_Mix$']=N: ['AAC_STD_Mix%']* ['Material_Cost_Baseline_STD'];
#['AAC_STD_RFP$']=N: ['AAC_STD_RFP%']* ['Material_Cost_Baseline_STD'];

#AAC STD unitaire lorsque pas de units
['AAC_STD', 'No_Segment', 'Repairs']= C: IF(['Total_Units', 'Retail']=0, ['COS$_STD'],['COS$_STD']\['Total_Units', 'Retail']);
['AAC_STD', 'No_Segment', 'Total_Prime']= C: IF(['Total_Units', 'Retail']=0, ['COS$_STD'],['COS$_STD']\['Total_Units', 'Retail']);
['AAC_STD', 'No_Segment'] =C: IF(['Total_Units', 'Replacement', 'Retail']=0, ['COS$_STD'], ['COS$_STD']\['Total_Units', 'Replacement', 'Retail']);
['AAC_STD', 'Kits_Retail'] =C: IF(['Total_Units', 'Replacement']=0, ['COS$_STD'], ['COS$_STD']\['Total_Units', 'Replacement']);
['AAC_STD', 'No_Segment_EXT']= C: IF(['Total_Units', 'Externe']=0, ['COS$_STD'],['COS$_STD']\['Total_Units', 'Externe']);
['AAC_STD']= C: IF(['Total_Units']=0, ['COS$_STD'],['COS$_STD']\['Total_Units']);

#Mart 9-22-2014 AAC_Pure unitaire lorsque pas de units (trsf danbs le cube 13)
['AAC_STD_Pure_Calc', 'No_Segment', 'Repairs'] =  IF(['Total_Units',  'Retail']=0, ['COS$_STD_Pure'], ['COS$_STD_Pure'] \ ['Total_Units',  'Retail']);
['AAC_STD_Pure_Calc', 'No_Segment', 'Total_Prime'] =  IF(['Total_Units',  'Retail']=0, ['COS$_STD_Pure'], ['COS$_STD_Pure'] \ ['Total_Units',  'Retail']);
['AAC_STD_Pure_Calc', 'No_Segment']=  IF(['Total_Units', 'Replacement',  'Retail']=0, ['COS$_STD_Pure'],['COS$_STD_Pure'] \ ['Total_Units', 'Replacement', 'Retail']);
['AAC_STD_Pure_Calc', 'Kits_Retail'] =  IF(['Total_Units', 'Replacement']=0, ['COS$_STD_Pure'], ['COS$_STD_Pure']\['Total_Units', 'Replacement']);
['AAC_STD_Pure_Calc', 'No_Segment_EXT']=  IF(['Total_Units', 'Externe']=0, ['COS$_STD_Pure'],['COS$_STD_Pure']\['Total_Units', 'Externe']);
['AAC_STD_Pure_Calc']=  IF(['Total_Units']=0, ['COS$_STD_Pure'],['COS$_STD_Pure']\['Total_Units']);

#Weighted average for total months
#['AAC_STD_Inc_Dec%', 'Total_Months']= (['AAC_STD_Inc_Dec%_Impact$']+['AAC_STD_Inc_Dec$'])\['Material_Cost_Baseline_STD'];
#['AAC_STD_Inc_Dec%']= C: (['AAC_STD_Inc_Dec%_Impact$']+['AAC_STD_Inc_Dec$'])\['Units_Baseline'];
