#######################################################################AIP BASELINE######################################################################
#AIP Baseline Replacement & Repairs :: Actual
##MART 2014-05-09 AIP Vanfax Replacement must exclud Sales Discounts
#AIP Baseline Actual Retail
['AIP_Baseline', 'Actual', 'Windshield'] =N:
	IF(ATTRS('Org_Structure_Leaf', !Org_Structure, 'SB_Code') @<> 'WH',
	DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Replacement', !Versions, !t_Years, !t_Months, 'ASP'), CONTINUE);
['AIP_Baseline', 'Actual', 'Repairs'] =N:
	IF(ATTRS('Org_Structure_Leaf', !Org_Structure, 'SB_Code') @<> 'WH',
	DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Repairs', !Versions, !t_Years, !t_Months, 'ASP'), CONTINUE);

#AIP Baseline Actual Vanfax
['AIP_Baseline', 'Actual', 'Windshield'] =N:
	IF(ATTRS('Org_Structure_Leaf', !Org_Structure, 'SB_Code') @= 'WH',
		IF((DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Windshield', !Versions, !t_Years, !t_Months, 'Sales_Units')
		+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Side', !Versions, !t_Years, !t_Months, 'Sales_Units')
		+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Back', !Versions, !t_Years, !t_Months, 'Sales_Units')
		+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'RV_Glass', !Versions, !t_Years, !t_Months, 'Sales_Units')
		+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Bus_Glass', !Versions, !t_Years, !t_Months, 'Sales_Units'))=0 ,
		(+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Windshield', !Versions, !t_Years, !t_Months, 'Sales$')
		+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Side', !Versions, !t_Years, !t_Months, 'Sales$')
		+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Back', !Versions, !t_Years, !t_Months, 'Sales$')
		+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'RV_Glass', !Versions, !t_Years, !t_Months, 'Sales$')
		+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Bus_Glass', !Versions, !t_Years, !t_Months, 'Sales$')),
			(DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Windshield', !Versions, !t_Years, !t_Months, 'Sales$')
			+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Side', !Versions, !t_Years, !t_Months, 'Sales$')
			+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Back', !Versions, !t_Years, !t_Months, 'Sales$')
			+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'RV_Glass', !Versions, !t_Years, !t_Months, 'Sales$')
			+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Bus_Glass', !Versions, !t_Years, !t_Months, 'Sales$'))
			\
			(DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Windshield', !Versions, !t_Years, !t_Months, 'Sales_Units')
			+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Side', !Versions, !t_Years, !t_Months, 'Sales_Units')
			+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Back', !Versions, !t_Years, !t_Months, 'Sales_Units')
			+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'RV_Glass', !Versions, !t_Years, !t_Months, 'Sales_Units')
			+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Bus_Glass', !Versions, !t_Years, !t_Months, 'Sales_Units')))
			, CONTINUE);

