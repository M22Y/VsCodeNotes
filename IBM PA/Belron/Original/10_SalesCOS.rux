#Material Cost Replacement Baseline Actual
#New Mart 2015-05-19 Split COS of Kit Retail From Replacement
['Material_Cost_Baseline', 'Actual', 'Windshield', 'No_Segment'] =N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH',
		IF((DB('83_Actuals_Stats', !Org_Structure, 'Retail', 'Windshield', !Versions, !t_Years, !t_Months, 'Sales_Units')
		+DB('83_Actuals_Stats', !Org_Structure,  'Retail', 'Side', !Versions, !t_Years, !t_Months, 'Sales_Units')
		+DB('83_Actuals_Stats', !Org_Structure,  'Retail', 'Back', !Versions, !t_Years, !t_Months, 'Sales_Units')
		+DB('83_Actuals_Stats', !Org_Structure,  'Retail', 'RV_Glass', !Versions, !t_Years, !t_Months, 'Sales_Units')
		+DB('83_Actuals_Stats', !Org_Structure,  'Retail', 'Bus_Glass', !Versions, !t_Years, !t_Months, 'Sales_Units'))=0 ,
		(+DB('83_Actuals_Stats', !Org_Structure,  !Customer_Segments, 'Windshield', !Versions, !t_Years, !t_Months, 'COS$')
		+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Side', !Versions, !t_Years, !t_Months, 'COS$')
		+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Back', !Versions, !t_Years, !t_Months, 'COS$')
		+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'RV_Glass', !Versions, !t_Years, !t_Months, 'COS$')
		+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Bus_Glass', !Versions, !t_Years, !t_Months, 'COS$')),
		(DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Windshield', !Versions, !t_Years, !t_Months, 'COS$')
		+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Side', !Versions, !t_Years, !t_Months, 'COS$')
		+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Back', !Versions, !t_Years, !t_Months, 'COS$')
		+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'RV_Glass', !Versions, !t_Years, !t_Months, 'COS$')
		+DB('83_Actuals_Stats', !Org_Structure, !Customer_Segments, 'Bus_Glass', !Versions, !t_Years, !t_Months, 'COS$')) /
		(DB('83_Actuals_Stats', !Org_Structure,  'Retail', 'Windshield', !Versions, !t_Years, !t_Months, 'Sales_Units')
		+DB('83_Actuals_Stats', !Org_Structure,  'Retail', 'Side', !Versions, !t_Years, !t_Months, 'Sales_Units')
		+DB('83_Actuals_Stats', !Org_Structure,  'Retail', 'Back', !Versions, !t_Years, !t_Months, 'Sales_Units')
		+DB('83_Actuals_Stats', !Org_Structure,  'Retail', 'RV_Glass', !Versions, !t_Years, !t_Months, 'Sales_Units')
		+DB('83_Actuals_Stats', !Org_Structure,  'Retail', 'Bus_Glass', !Versions, !t_Years, !t_Months, 'Sales_Units'))), CONTINUE);

