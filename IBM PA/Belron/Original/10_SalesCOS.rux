        CONTINUE,
        DB( '111_SalesCOS_ADAS',!Org_Structure, 'ADAS_BUDGET', !Customer_Segments,!Versions,!t_Years,!t_Months, 'Net_Sales')
    );


['Sales_Baseline', {'Forecast', 'Rolling_Fct_Adj'}, 'Sales_Discounts']= N:
		IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
	          ['Actual', 'Sales_Baseline'],
			['ASP']* IF( ['Total_Units', 'Replacement']=0, 1, ['Total_Units', 'Replacement']));
['Sales_Baseline', 'Budget', 'Sales_Discounts']= N:  ['ASP']* ['Total_Units', 'Replacement'];
['Sales_Baseline', 'Actual']= N: ['ASP']* IF( ['Total_Units']= 0, 1, ['Total_Units']);
['Sales_Baseline', {'Forecast', 'Rolling_Fct_Adj'}]=
		IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
		['Sales_Baseline', 'Actual'],
		CONTINUE);
['Sales_Baseline', {'Forecast', 'Rolling_Fct_Adj', 'Budget'}]= N: ['ASP']*  ['Total_Units'];


