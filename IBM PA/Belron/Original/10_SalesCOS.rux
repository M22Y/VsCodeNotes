#To freeze all historical  measures
['Budget', {'2014', '2015', '2016'}]= N:STET;
['Forecast', {'2013', '2014', '2015'}]= N:STET;
#[{'Bud_Topline', 'Budget_V1', 'Budget_V2', 'Budget_V3', 'Fct_Topline', 'Forecast_5_7', 'Forecast_6_6', 'Forecast_7_5', 'Forecast_8_4', 'Forecast_9_3', 'Forecast_10_2', 'Forecast_11_1'}, {'2013', '2014', '2015'}]= N:0;
