		DB('10_SalesCOS', !Org_Structure, !Products_Detailed, !Customer_Segments, 'Budget', '2021', !t_Months, 'Units_Baseline');

['ASP', 'Actual', '2019'] =>
		DB(IF(!Products_Detailed @<> 'Glass_Accessories','10_SalesCOS', ''),
            !Org_Structure, !Products_Detailed, !Customer_Segments, 'Budget', '2021', !t_Months, 'AIP_Baseline');

['AAC_Pure', 'Actual', '2019'] =>
		DB(IF(!Products_Detailed @<> 'Glass_Accessories','10_SalesCOS', ''),
            !Org_Structure, !Products_Detailed, !Customer_Segments, 'Budget', '2021', !t_Months, 'Material_Cost_Baseline');

['AAC_STD_Pure', 'Actual', '2019'] =>
		DB(IF(!Products_Detailed @<> 'Glass_Accessories','10_SalesCOS',''),
            !Org_Structure, !Products_Detailed, !Customer_Segments, 'Budget', '2021', !t_Months, 'Material_Cost_Baseline_STD');

