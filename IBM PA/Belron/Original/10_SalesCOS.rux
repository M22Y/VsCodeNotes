#Mart complete this list
['Glass_Related_Sales$', {'Forecast', 'Budget', 'Rolling_Fct_Adj'}]= N:
	IF(ATTRS('Org_Structure_Leaf',  !Org_Structure, 'SB_Code') @<> 'WH', 0, CONTINUE);
[{'GM%_Baseline', 'GM%_Revised', 'Prime_Units_Glass_Related_Consumer', 'Replacement_Units_Glass_Related', 'Glass_Related_Sales%', 'Glass_Related_Units_Adjusted'} ] =N: 0;
#Only use by the Non-Prime Products in Cube#11
[{'Sales_Inc_Dec$','Sales_Inc_Dec%','Sales_Inc_Dec%_Impact$'}]= IF(!t_years @= '2013' & !versions @= 'Budget', CONTINUE, 0);
#Weighted average for total months
['Sales_Inc_Dec%', 'Total_Months']= ['Sales_Inc_Dec%_Impact$']\ ['Sales_Baseline'];
['Sales_Inc_Dec%']= C: (['Sales_Inc_Dec%_Impact$']+['Sales_Inc_Dec$'])\ ['Sales_Baseline'];


#############Units Baseline#################
