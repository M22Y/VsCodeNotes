		DB('84_Actuals_GL', !Org_Structure, '003142', !Versions, !t_Years, !t_Months, 'Dollars$')-
		DB('84_Actuals_GL', !Org_Structure, '003144', !Versions, !t_Years, !t_Months, 'Dollars$')-
		DB('84_Actuals_GL', !Org_Structure, '003145', !Versions, !t_Years, !t_Months, 'Dollars$')),0);

