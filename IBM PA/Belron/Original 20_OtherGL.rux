#Mart 10-24-13 ajout Depreciation
#region Capex depuis Cube 56
['045100', {'Forecast', 'Rolling_Fct_Adj'}, 'Baseline']= N:
	IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
	['Actual', 'Adjusted_Total'],
DB('56_Capex_Dep', !Org_Structure, '5029', !Versions, !t_Months |'-' | SUBST(!t_Years,3,2), 'Total_Depreciation')+
