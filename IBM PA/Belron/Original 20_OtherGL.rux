########################Base Line##########################################
#Actual Base Line
['Baseline', 'Actual']=N: DB('84_Actuals_GL', !Org_Structure, !GL_Accounts_Line, !Versions, !t_Years, !t_Months, 'Dollars$');
#Forecast Base Line
['Baseline', 'Forecast']=N:
IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
		['Actual', 'Adjusted_Total'],
		DB('20_OtherGL', !Org_Structure, !GL_Accounts_Line, 'Budget', !t_Years, !t_Months, 'Adjusted_Total'));

#Start in 2015
['Baseline', 'Rolling_Fct_Adj', '2015']=N:
IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
		['Actual', 'Adjusted_Total'],
		DB('20_OtherGL', !Org_Structure, !GL_Accounts_Line, 'Budget', !t_Years, !t_Months, 'Adjusted_Total'));

# adjusted for 2025 Rolling_Fct_Adj
['Baseline', 'Rolling_Fct_Adj', '2025']=N:
IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
		['Actual', 'Adjusted_Total'],
		DB('20_OtherGL', !Org_Structure, !GL_Accounts_Line, 'Budget_Final', !t_Years, !t_Months, 'Adjusted_Total'));

['Baseline', 'Rolling_Fct_Adj']=N:
IF(DB('97_Actual_Flags', !t_Years, !t_Months, !Versions)=1,
		['Actual', 'Adjusted_Total'],
		DB('20_OtherGL', !Org_Structure, !GL_Accounts_Line, !Versions, ATTRS('t_Years', !t_Years, 'Prev_Yr'), !t_Months, 'Adjusted_Total'));




